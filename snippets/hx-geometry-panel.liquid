{% comment %}
  Snippet: hx-geometry-panel
  Usage:
  {% render 'hx-geometry-panel',
    title: 'Geometry',
    image_url: 'https://cdn.shopify.com/s/files/1/0940/2590/8589/files/hxebike-shark-mako-parameter_1.png?v=1769506013',
    image_alt: 'Geometry diagram',
    image_url_2: 'https://cdn.shopify.com/s/files/1/0940/2590/8589/files/HX-Q5-outer_box.jpg?v=1774237202',
    image_alt_2: 'HX-Q5 outer box'
  %}
{% endcomment %}

{%- assign geo_title = title | default: 'Geometry' -%}
{%- assign geo_image_alt = image_alt | default: 'Geometry diagram' -%}
{%- assign geo_image_alt_2 = image_alt_2 | default: 'HX-Q5 outer box' -%}
{%- assign geo_default_img = 'https://cdn.shopify.com/s/files/1/0940/2590/8589/files/hxebike-shark-mako-parameter_1.png?v=1769506013' -%}
{%- assign geo_default_img_2 = 'https://cdn.shopify.com/s/files/1/0940/2590/8589/files/HX-Q5-outer_box.jpg?v=1774237202' -%}
{%- assign geo_img = image_url | default: geo_default_img -%}
{%- assign geo_img_2 = image_url_2 | default: geo_default_img_2 -%}

<section class="hxGeo">
  <div class="hxGeo__container">
    <div class="hxGeo__grid">
      <!-- Block 1: Parameters (built-in) -->
      <div class="hxGeo__block hxGeo__block--params">

        <div class="hxGeo__table" role="table" aria-label="Geometry parameters">
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Frame Size</div><div class="hxGeo__v" role="cell">Standard</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Wheel Size</div><div class="hxGeo__v" role="cell">27.5&quot; × 2.25&quot;</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Seat Tube Length</div><div class="hxGeo__v" role="cell">12.6&quot; / 32 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Top Tube Length (Horizontal)</div><div class="hxGeo__v" role="cell">7.9&quot; / 20 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Bottom Bracket Drop</div><div class="hxGeo__v" role="cell">1.6&quot; / 4 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Head Tube Length</div><div class="hxGeo__v" role="cell">4.3&quot; / 11 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Head Tube Angle</div><div class="hxGeo__v" role="cell">71°</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Seat Tube Angle</div><div class="hxGeo__v" role="cell">73°</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Rear Chainstay Length</div><div class="hxGeo__v" role="cell">6.9&quot; / 17.5 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Front Wheel Center</div><div class="hxGeo__v" role="cell">10.6&quot; / 27 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Wheelbase</div><div class="hxGeo__v" role="cell">48.8&quot; / 124 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Reach</div><div class="hxGeo__v" role="cell">18.1&quot; / 46 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Stack Height</div><div class="hxGeo__v" role="cell">8.5&quot; / 21.5 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Fork Length</div><div class="hxGeo__v" role="cell">7.5&quot; / 19 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Fork Offset</div><div class="hxGeo__v" role="cell">1.6&quot; / 4 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Trail</div><div class="hxGeo__v" role="cell">3.1&quot; / 7.97 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Standover Height</div><div class="hxGeo__v" role="cell">28.7&quot; / 73 cm</div></div>
          <div class="hxGeo__row" role="row"><div class="hxGeo__k" role="cell">Rider Height</div><div class="hxGeo__v" role="cell">5'5&quot; ~ 6'5&quot; (165 ~ 190 cm)</div></div>
        </div>
      </div>

      <!-- Block 2: Images -->
      <div class="hxGeo__block hxGeo__block--image">
        <div class="hxGeo__imageStack">
          <img class="hxGeo__img" src="{{ geo_img }}" alt="{{ geo_image_alt | escape }}" loading="lazy">

          {%- if geo_img_2 != blank -%}
            <img class="hxGeo__img hxGeo__img--secondary" src="{{ geo_img_2 }}" alt="{{ geo_image_alt_2 | escape }}" loading="lazy">
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <style>
    .hxGeo{ padding:32px 0; color:#111; font-family:var(--font-body-family, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif); }
    .hxGeo *{ box-sizing:border-box; }

    .hxGeo__container{ max-width:1680px; margin:0 auto; padding:0 clamp(16px,3vw,64px); }

    .hxGeo__grid{
      display:grid;
      grid-template-columns: 1fr 1.1fr;
      gap: clamp(18px, 3vw, 56px);
      align-items:start;
    }

    .hxGeo__title{
      margin:0 0 18px;
      font-size:28px;
      line-height:1.15;
      font-weight:600;
      letter-spacing:-0.01em;
    }

    .hxGeo__table{ border-top:1px solid rgba(0,0,0,.10); }
    .hxGeo__row{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:12px;
      padding:16px 0;
      border-bottom:1px solid rgba(0,0,0,.06);
    }
    .hxGeo__k, .hxGeo__v{
      font-size:15px;
      line-height:1.5;
      font-weight:400;
    }
    .hxGeo__k{ color:rgba(0,0,0,.86); }
    .hxGeo__v{ color:rgba(0,0,0,.62); text-align:right; }

    .hxGeo__imageStack{
      display:flex;
      flex-direction:column;
      gap:24px;
    }

    .hxGeo__img{
      width:100%;
      height:auto;
      display:block;
      border-radius:12px;
    }

    @media (max-width:990px){
      .hxGeo{ padding:20px 0; }
      .hxGeo__container{ max-width:100%; padding:0; }
      .hxGeo__grid{ grid-template-columns:1fr; gap:16px; }
      .hxGeo__block--image{ order:0; }
      .hxGeo__block--params{ order:1; padding:0 clamp(16px,3vw,24px); }
      .hxGeo__title{ font-size:22px; margin:6px 0 14px; }
      .hxGeo__imageStack{ gap:16px; }
      .hxGeo__img{ border-radius:0; width:100%; }
      .hxGeo__row{ padding:14px 0; }
      .hxGeo__k, .hxGeo__v{ font-size:14px; }
    }
  </style>
</section>
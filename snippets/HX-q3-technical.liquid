{% comment %}
  Snippet: HX-q3-technical
  Usage:
  {% render 'HX-q3-technical', title: 'Technical' %}
{% endcomment %}

{%- assign tech_title = title | default: 'Technical' -%}

<section class="hxTechQ3">
  <div class="hxTechQ3__container">
    <h3 class="hxTechQ3__title">{{ tech_title }}</h3>

    <div class="hxTechQ3__grid" role="table" aria-label="Q3 technical parameters">
      <!-- Left column -->
      <div class="hxTechQ3__col" role="rowgroup">
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Suspension</div><div class="hxTechQ3__v" role="cell">80mm travel</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Sensor</div><div class="hxTechQ3__v" role="cell">Cadence Sensor</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Throttle</div><div class="hxTechQ3__v" role="cell">Twist Throttle</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Motor</div><div class="hxTechQ3__v" role="cell">48V / 2000W Peak Power Brushless Motor</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Battery Lifetime</div><div class="hxTechQ3__v" role="cell">Up to 800 charge cycles</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Charger</div><div class="hxTechQ3__v" role="cell">54.6V</div></div>

        <!-- 新增 -->
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Waterproof Rating</div><div class="hxTechQ3__v" role="cell">IPX6</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Gear System</div><div class="hxTechQ3__v" role="cell">7-Speed</div></div>
      </div>

      <!-- Right column -->
      <div class="hxTechQ3__col" role="rowgroup">
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Weight</div><div class="hxTechQ3__v" role="cell">75 lbs</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Payload Capacity</div><div class="hxTechQ3__v" role="cell">661 lbs</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Range</div><div class="hxTechQ3__v" role="cell">60 Miles</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Top Speed</div><div class="hxTechQ3__v" role="cell">37 MPH</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Tires</div><div class="hxTechQ3__v" role="cell">20&quot; × 4.0&quot;</div></div>
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Battery</div><div class="hxTechQ3__v" role="cell">48V / 20AH Lithium Battery</div></div>

        <!-- 新增 -->
        <div class="hxTechQ3__row" role="row"><div class="hxTechQ3__k" role="cell">Maximum Hill Climbing Angle</div><div class="hxTechQ3__v" role="cell">35°</div></div>
      </div>
    </div>
  </div>

  <style>
    .hxTechQ3{
      padding:32px 0;
      color:#111;
      font-family:var(--font-body-family, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif);
    }

    .hxTechQ3 *{
      box-sizing:border-box;
    }

    .hxTechQ3__container{
      max-width:1680px;
      margin:0 auto;
      padding:0 clamp(16px,3vw,64px);
    }

    .hxTechQ3__title{
      margin:0 0 18px;
      font-size:28px;
      line-height:1.15;
      font-weight:600;
      letter-spacing:-0.01em;
    }

    .hxTechQ3__grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:clamp(18px, 3vw, 56px);
      border-top:1px solid rgba(0,0,0,.10);
    }

    .hxTechQ3__row{
      display:grid;
      grid-template-columns:240px 1fr;
      gap:16px;
      padding:16px 0;
      border-bottom:1px solid rgba(0,0,0,.06);
      align-items:start;
    }

    .hxTechQ3__k,
    .hxTechQ3__v{
      font-size:15px;
      line-height:1.5;
      font-weight:400;
    }

    .hxTechQ3__k{
      color:rgba(0,0,0,.86);
    }

    .hxTechQ3__v{
      color:rgba(0,0,0,.62);
    }

    @media (max-width:990px){
      .hxTechQ3{
        padding:20px 0;
      }

      .hxTechQ3__container{
        max-width:100%;
        padding:0 clamp(16px,3vw,24px);
      }

      .hxTechQ3__title{
        font-size:22px;
        margin:6px 0 14px;
      }

      .hxTechQ3__grid{
        grid-template-columns:1fr;
        gap:0;
      }

      .hxTechQ3__row{
        grid-template-columns:1fr 1fr;
        gap:12px;
        padding:14px 0;
      }

      .hxTechQ3__k,
      .hxTechQ3__v{
        font-size:14px;
      }

      .hxTechQ3__v{
        text-align:right;
      }
    }

    @media (max-width:420px){
      .hxTechQ3__row{
        grid-template-columns:1.2fr 0.8fr;
      }
    }
  </style>
</section>
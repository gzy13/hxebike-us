        "liquid_tpp9p7": {
          "type": "liquid",
          "settings": {
            "liquid": "<style>\n  .payment-logos-wrapper {\n    display: inline-block;   /* 关键：宽度自动随图片 */\n    text-align: center;\n    margin-top: 6px;\n    margin-bottom: 6px;\n  }\n\n  .payment-logos-container {\n    width: 100%;\n    text-align: center;      /* 让 wrapper 居中 */\n  }\n\n  .payment-logos-wrapper img {\n    height: auto;\n    max-width: 100%;\n    display: block;          /* 避免底部多余空隙 */\n  }\n\n  /* Mobile optimization */\n  @media (max-width: 768px) {\n    .payment-logos-wrapper {\n      margin-top: 4px;\n      margin-bottom: 4px;\n    }\n    .payment-logos-wrapper img {\n      max-width: 90%;\n    }\n  }\n</style>\n\n<div class=\"payment-logos-container\">\n  <div class=\"payment-logos-wrapper\">\n    <img \n      src=\"https://cdn.shopify.com/s/files/1/0940/2590/8589/files/payment-tuttio.avif?v=1764662305\"\n      alt=\"Payment Methods\"\n      loading=\"lazy\"\n    >\n  </div>\n</div>"
          }

{% liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign has_manual_products = false
  if product_blocks.size > 0
    assign has_manual_products = true
  endif
%}

<section
  id="HxFeaturedScooters-{{ section.id }}"
  class="hx-featured-scooters"
  style="
    --hx-section-bg: {{ section.settings.background_color }};
    --hx-card-bg: {{ section.settings.card_background }};
    --hx-text: {{ section.settings.text_color }};
    --hx-muted: {{ section.settings.muted_color }};
    --hx-price: {{ section.settings.price_color }};
    --hx-compare: {{ section.settings.compare_price_color }};
    --hx-button-bg: {{ section.settings.button_background }};
    --hx-button-text: {{ section.settings.button_text_color }};
    --hx-badge-bg: {{ section.settings.badge_background }};
    --hx-badge-text: {{ section.settings.badge_text_color }};
  "
>
  <div class="hx-featured-scooters__inner">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="hx-featured-scooters__header hx-featured-scooters__header--{{ section.settings.heading_alignment }}">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="hx-featured-scooters__list">
      {% if has_manual_products %}
        {% for block in product_blocks %}
          {% liquid
            assign product = block.settings.product
            assign product_title = block.settings.title
            assign product_url = block.settings.link
            assign product_image = block.settings.image
            assign product_subtitle = block.settings.subtitle
            assign price_text = block.settings.price_text
            assign compare_price_text = block.settings.compare_price_text
            assign badge_text = block.settings.badge_text

            if product != blank
              if product_title == blank
                assign product_title = product.title
              endif
              if product_url == blank
                assign product_url = product.url
              endif
              if product_image == blank
                assign product_image = product.featured_image
              endif
              if price_text == blank
                assign price_text = product.price | money
              endif
              if compare_price_text == blank and product.compare_at_price > product.price
                assign compare_price_text = product.compare_at_price | money
              endif
            endif

            if product_title == blank
              assign product_title = 'HX Electric Scooter'
            endif
          %}

          <article class="hx-featured-product" itemscope itemtype="https://schema.org/Product" {{ block.shopify_attributes }}>
            {% if badge_text != blank %}
              <div class="hx-featured-product__badge">{{ badge_text }}</div>
            {% endif %}

            <a class="hx-featured-product__media-link" href="{{ product_url | default: '#' }}" aria-label="{{ product_title | escape }}">
              <div class="hx-featured-product__media">
                {% if product_image != blank %}
                  {{
                    product_image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '480, 720, 960, 1200, 1400, 1600',
                      sizes: '(min-width: 990px) 52vw, 100vw',
                      alt: product_title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
            </a>

            <div class="hx-featured-product__content">
              <a href="{{ product_url | default: '#' }}" class="hx-featured-product__title-link" itemprop="url">
                <h3 itemprop="name">{{ product_title }}</h3>
              </a>

              {% if product_subtitle != blank %}
                <p class="hx-featured-product__description" itemprop="description">{{ product_subtitle }}</p>
              {% endif %}

              <ul class="hx-featured-product__features">
                {% for i in (1..4) %}
                  {% liquid
                    assign point_key = 'point_' | append: i
                    assign point = block.settings[point_key]
                  %}
                  {% if point != blank %}
                    <li>{{ point }}</li>
                  {% endif %}
                {% endfor %}
              </ul>

              <div class="hx-featured-product__footer">
                <div class="hx-featured-product__prices">
                  {% if price_text != blank %}
                    <span class="hx-featured-product__price">{{ price_text }}</span>
                  {% endif %}

                  {% if compare_price_text != blank %}
                    <span class="hx-featured-product__compare-price">{{ compare_price_text }}</span>
                  {% endif %}
                </div>

                <a class="hx-featured-product__button" href="{{ product_url | default: '#' }}">
                  {{ block.settings.button_text | default: section.settings.button_text }}
                </a>
              </div>
            </div>
          </article>
        {% endfor %}
      {% elsif section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% liquid
            assign product_title = product.title
            assign product_url = product.url
            assign product_image = product.featured_image
            assign product_subtitle = product.metafields.custom.subtitle.value
            assign points_text = product.metafields.custom.sale_points.value
            assign compare_price_text = blank

            if product.compare_at_price > product.price
              assign compare_price_text = product.compare_at_price | money
            endif
          %}

          <article class="hx-featured-product" itemscope itemtype="https://schema.org/Product">
            {% if section.settings.collection_badge_text != blank %}
              <div class="hx-featured-product__badge">{{ section.settings.collection_badge_text }}</div>
            {% endif %}

            <a class="hx-featured-product__media-link" href="{{ product_url }}" aria-label="{{ product_title | escape }}">
              <div class="hx-featured-product__media">
                {% if product_image != blank %}
                  {{
                    product_image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '480, 720, 960, 1200, 1400, 1600',
                      sizes: '(min-width: 990px) 52vw, 100vw',
                      alt: product_title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
            </a>

            <div class="hx-featured-product__content">
              <a href="{{ product_url }}" class="hx-featured-product__title-link" itemprop="url">
                <h3 itemprop="name">{{ product_title }}</h3>
              </a>

              {% if product_subtitle != blank %}
                <p class="hx-featured-product__description" itemprop="description">{{ product_subtitle }}</p>
              {% endif %}

              {% if points_text != blank %}
                <ul class="hx-featured-product__features">
                  {% assign points = points_text | newline_to_br | split: '<br />' %}
                  {% for point in points limit: 4 %}
                    {% if point != blank %}
                      <li>{{ point | strip }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% endif %}

              <div class="hx-featured-product__footer">
                <div class="hx-featured-product__prices">
                  <span class="hx-featured-product__price">{{ product.price | money }}</span>

                  {% if compare_price_text != blank %}
                    <span class="hx-featured-product__compare-price">{{ compare_price_text }}</span>
                  {% endif %}
                </div>

                <a class="hx-featured-product__button" href="{{ product_url }}">
                  {{ section.settings.button_text }}
                </a>
              </div>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <article class="hx-featured-product" itemscope itemtype="https://schema.org/Product">
          <div class="hx-featured-product__badge">NEW</div>
          <a class="hx-featured-product__media-link" href="#" aria-label="HX Electric Scooter">
            <div class="hx-featured-product__media">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </a>
          <div class="hx-featured-product__content">
            <a href="#" class="hx-featured-product__title-link" itemprop="url">
              <h3 itemprop="name">HX Electric Scooter</h3>
            </a>
            <p class="hx-featured-product__description" itemprop="description">Add a product block or choose a collection in the section settings.</p>
            <ul class="hx-featured-product__features">
              <li>Lightweight frame</li>
              <li>Long range battery</li>
              <li>Multiple riding modes</li>
              <li>High payload</li>
            </ul>
            <div class="hx-featured-product__footer">
              <div class="hx-featured-product__prices">
                <span class="hx-featured-product__price">$249.00</span>
                <span class="hx-featured-product__compare-price">$599.00</span>
              </div>
              <a class="hx-featured-product__button" href="#">{{ section.settings.button_text }}</a>
            </div>
          </div>
        </article>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #HxFeaturedScooters-{{ section.id }} {
    background: var(--hx-section-bg);
    color: var(--hx-text);
    font-family: var(--font-body-family, Montserrat, Arial, sans-serif);
    padding: clamp(24px, 4vw, 56px) 0;
  }

  #HxFeaturedScooters-{{ section.id }} * {
    box-sizing: border-box;
  }

  #HxFeaturedScooters-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-scooters__inner {
    width: min(100% - 32px, {{ section.settings.container_width }}px);
    margin: 0 auto;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-scooters__header {
    margin-bottom: clamp(22px, 3vw, 40px);
    text-align: {{ section.settings.heading_alignment }};
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-scooters__header h2 {
    margin: 0;
    color: var(--hx-text);
    font-size: clamp(28px, 3.5vw, 48px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-scooters__header p {
    max-width: 760px;
    margin: 10px 0 0;
    color: var(--hx-muted);
    font-size: 15px;
    line-height: 1.55;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-scooters__header--center p {
    margin-inline: auto;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-scooters__list {
    display: grid;
    gap: clamp(18px, 2vw, 28px);
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.34fr) minmax(360px, 0.86fr);
    align-items: center;
    gap: clamp(34px, 5vw, 86px);
    min-height: clamp(430px, 38vw, 610px);
    padding: clamp(54px, 5vw, 88px) clamp(54px, 6vw, 112px);
    overflow: hidden;
    background: var(--hx-card-bg);
    border-radius: {{ section.settings.card_radius }}px;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__badge {
    position: absolute;
    top: 0;
    left: clamp(54px, 6.8vw, 112px);
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    width: 68px;
    height: 88px;
    padding-top: 29px;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 75%, 0 100%);
    background: var(--hx-badge-bg);
    color: var(--hx-badge-text);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media-link,
  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    width: 100%;
    height: 100%;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media img,
  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media svg {
    display: block;
    width: 100%;
    max-width: 720px;
    max-height: 430px;
    object-fit: contain;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__content {
    min-width: 0;
    max-width: 500px;
    padding-top: 8px;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__title-link h3 {
    margin: 0;
    color: var(--hx-text);
    font-family: var(--font-heading-family, var(--font-body-family, Montserrat, Arial, sans-serif));
    font-size: clamp(28px, 2.2vw, 36px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.35;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__description {
    margin: 12px 0 0;
    color: var(--hx-text);
    font-size: 15px;
    line-height: 1.45;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px clamp(28px, 4vw, 78px);
    margin: 44px 0 0;
    padding: 0 0 0 18px;
    color: var(--hx-text);
    font-size: 15px;
    line-height: 1.35;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    margin-top: 42px;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__prices {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
    white-space: nowrap;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__price {
    color: var(--hx-price);
    font-size: clamp(24px, 2vw, 30px);
    font-weight: 700;
    line-height: 1;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__compare-price {
    color: var(--hx-compare);
    font-size: 18px;
    line-height: 1;
    text-decoration: line-through;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 140px;
    min-height: 40px;
    padding: 10px 24px;
    border-radius: 999px;
    background: var(--hx-button-bg);
    color: var(--hx-button-text);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    transition: opacity 0.2s ease;
  }

  #HxFeaturedScooters-{{ section.id }} .hx-featured-product__button:hover {
    opacity: 0.86;
  }

  @media screen and (max-width: 1180px) {
    #HxFeaturedScooters-{{ section.id }} .hx-featured-product {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.9fr);
      gap: 34px;
      padding-inline: clamp(30px, 5vw, 64px);
    }
  }

  @media screen and (max-width: 860px) {
    #HxFeaturedScooters-{{ section.id }} .hx-featured-product {
      grid-template-columns: 1fr;
      gap: 14px;
      min-height: auto;
      padding: 72px 22px 24px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__badge {
      left: 28px;
      width: 58px;
      height: 76px;
      padding-top: 24px;
      font-size: 12px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media img,
    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media svg {
      max-height: 320px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__content {
      max-width: none;
      padding-top: 0;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__title-link h3 {
      font-size: clamp(24px, 7vw, 32px);
      line-height: 1.2;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__features {
      margin-top: 18px;
      gap: 6px 18px;
      font-size: 14px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__footer {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 14px;
      margin-top: 20px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__button {
      width: fit-content;
    }
  }

  @media screen and (max-width: 520px) {
    #HxFeaturedScooters-{{ section.id }} .hx-featured-scooters__inner {
      width: min(100% - 24px, {{ section.settings.container_width }}px);
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product {
      border-radius: max(8px, {{ section.settings.card_radius }}px - 4px);
      padding: 66px 14px 18px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__badge {
      left: 22px;
      width: 52px;
      height: 68px;
      padding-top: 21px;
      font-size: 11px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media img,
    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media svg {
      width: min(100%, 310px);
      max-height: 300px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__description {
      margin-top: 8px;
      font-size: 14px;
      line-height: 1.35;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__features {
      grid-template-columns: 1fr;
      margin-top: 14px;
      font-size: 13px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__footer {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 10px;
      margin-top: 16px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__prices {
      flex-wrap: wrap;
      gap: 6px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__price {
      font-size: 22px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__compare-price {
      font-size: 14px;
    }

    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__button {
      min-height: 36px;
      min-width: 106px;
      padding: 9px 16px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 380px) {
    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media img,
    #HxFeaturedScooters-{{ section.id }} .hx-featured-product__media svg {
      width: min(100%, 280px);
      max-height: 270px;
    }
  }
</style>

{% schema %}
{
  "name": "HX featured scooter",
  "tag": "section",
  "class": "section-hx-featured-scooters",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "text",
      "id": "collection_badge_text",
      "label": "Collection badge text",
      "default": "NEW"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#4c5154"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare price",
      "default": "#9a9a9a"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#ff3f3f"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Featured product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "NEW"
        },
        {
          "type": "text",
          "id": "point_1",
          "label": "Feature 1",
          "default": "7.2kg lightweight"
        },
        {
          "type": "text",
          "id": "point_2",
          "label": "Feature 2",
          "default": "Parental Control"
        },
        {
          "type": "text",
          "id": "point_3",
          "label": "Feature 3",
          "default": "Three Riding Modes"
        },

{% liquid
  assign section_id = 'gigi-compare-' | append: section.id
  assign product_1_alt = section.settings.product_1_image_alt | default: section.settings.product_1_title
  assign product_2_alt = section.settings.product_2_image_alt | default: section.settings.product_2_title
  assign product_1_initial_image = section.settings.product_1_color_1_image | default: section.settings.product_1_image
  assign product_2_initial_image = section.settings.product_2_color_1_image | default: section.settings.product_2_image
%}

<section
  id="{{ section_id }}"
  class="gigi-compare"
  style="
    --gigi-bg: {{ section.settings.background_color }};
    --gigi-text: {{ section.settings.text_color }};
    --gigi-muted: {{ section.settings.muted_color }};
    --gigi-heading: {{ section.settings.heading_color }};
    --gigi-line: {{ section.settings.border_color }};
    --gigi-column-bg: {{ section.settings.highlight_column_color }};
    --gigi-card-bg: {{ section.settings.card_background }};
    --gigi-button-bg: {{ section.settings.button_background }};
    --gigi-button-text: {{ section.settings.button_text_color }};
    --gigi-button-hover-bg: {{ section.settings.button_hover_background }};
    --gigi-button-hover-text: {{ section.settings.button_hover_text_color }};
    --gigi-image-blend: {% if section.settings.enable_image_multiply %}multiply{% else %}normal{% endif %};
    --gigi-radius: {{ section.settings.corner_radius }}px;
    --gigi-max-width: {{ section.settings.max_width }}px;
    --gigi-padding-top: {{ section.settings.padding_top }}px;
    --gigi-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-gigi-compare
>
  <div class="gigi-compare__inner">
    {% if section.settings.heading != blank %}
      <h2 class="gigi-compare__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="gigi-compare__scroller" data-gigi-scroller>
      <table class="gigi-compare__table">
        <thead>
          <tr>
            <th class="gigi-compare__sticky gigi-compare__label-cell" scope="col">
              {{ section.settings.model_label | escape }}
            </th>
            <th class="gigi-compare__product-heading gigi-compare__highlight" scope="col">
              {% if section.settings.product_1_link != blank %}
                <a href="{{ section.settings.product_1_link }}">{{ section.settings.product_1_title | escape }}</a>
              {% else %}
                <span>{{ section.settings.product_1_title | escape }}</span>
              {% endif %}
            </th>
            <th class="gigi-compare__product-heading" scope="col">
              {% if section.settings.product_2_link != blank %}
                <a href="{{ section.settings.product_2_link }}">{{ section.settings.product_2_title | escape }}</a>
              {% else %}
                <span>{{ section.settings.product_2_title | escape }}</span>
              {% endif %}
            </th>
          </tr>
        </thead>

        <tbody>
          <tr class="gigi-compare__product-row">
            <td class="gigi-compare__sticky gigi-compare__label-cell"></td>
            <td class="gigi-compare__highlight">
              <div class="gigi-compare__product-card" data-gigi-product-card>
                <a class="gigi-compare__image-link" href="{{ section.settings.product_1_link | default: '#' }}" aria-label="{{ section.settings.product_1_title | escape }}">
                  {% if product_1_initial_image != blank %}
                    {{
                      product_1_initial_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '280, 420, 560, 760, 960, 1200',
                        sizes: '(max-width: 749px) 30vw, 32vw',
                        alt: product_1_alt,
                        class: 'gigi-compare__image',
                        data-gigi-product-image: ''
                    }}
                  {% else %}
                    <div class="gigi-compare__placeholder" data-gigi-product-image>
                      {{ section.settings.product_1_title | default: 'Product' | slice: 0 | upcase }}
                    </div>
                  {% endif %}
                </a>

                <div class="gigi-compare__variants">
                  <span class="gigi-compare__variant-name" data-gigi-variant-name></span>
                  <div class="gigi-compare__swatches" role="list" aria-label="{{ section.settings.product_1_title | escape }} colors">
                    <button
                      class="gigi-compare__swatch is-active"
                      type="button"
                      role="listitem"
                      aria-label="{{ section.settings.product_1_color_1_label | escape }}"
                      aria-pressed="true"
                      title="{{ section.settings.product_1_color_1_label | escape }}"
                      data-gigi-swatch
                      data-label="{{ section.settings.product_1_color_1_label | escape }}"
                      {% if product_1_initial_image != blank %}
                        data-image="{{ product_1_initial_image | image_url: width: 1200 }}"
                      {% endif %}
                      style="--gigi-swatch: {{ section.settings.product_1_color_1 }};"
                    ></button>

                    <button
                      class="gigi-compare__swatch"
                      type="button"
                      role="listitem"
                      aria-label="{{ section.settings.product_1_color_2_label | escape }}"
                      aria-pressed="false"
                      title="{{ section.settings.product_1_color_2_label | escape }}"
                      data-gigi-swatch
                      data-label="{{ section.settings.product_1_color_2_label | escape }}"
                      {% if section.settings.product_1_color_2_image != blank %}
                        data-image="{{ section.settings.product_1_color_2_image | image_url: width: 1200 }}"
                      {% endif %}
                      style="--gigi-swatch: {{ section.settings.product_1_color_2 }};"
                    ></button>
                  </div>
                </div>
              </div>
            </td>

            <td>
              <div class="gigi-compare__product-card" data-gigi-product-card>
                <a class="gigi-compare__image-link" href="{{ section.settings.product_2_link | default: '#' }}" aria-label="{{ section.settings.product_2_title | escape }}">
                  {% if product_2_initial_image != blank %}
                    {{
                      product_2_initial_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '280, 420, 560, 760, 960, 1200',
                        sizes: '(max-width: 749px) 30vw, 32vw',
                        alt: product_2_alt,
                        class: 'gigi-compare__image',
                        data-gigi-product-image: ''
                    }}
                  {% else %}
                    <div class="gigi-compare__placeholder" data-gigi-product-image>
                      {{ section.settings.product_2_title | default: 'Product' | slice: 0 | upcase }}
                    </div>
                  {% endif %}
                </a>

                <div class="gigi-compare__variants">
                  <span class="gigi-compare__variant-name" data-gigi-variant-name></span>
                  <div class="gigi-compare__swatches" role="list" aria-label="{{ section.settings.product_2_title | escape }} colors">
                    <button
                      class="gigi-compare__swatch is-active"
                      type="button"
                      role="listitem"
                      aria-label="{{ section.settings.product_2_color_1_label | escape }}"
                      aria-pressed="true"
                      title="{{ section.settings.product_2_color_1_label | escape }}"
                      data-gigi-swatch
                      data-label="{{ section.settings.product_2_color_1_label | escape }}"
                      {% if product_2_initial_image != blank %}
                        data-image="{{ product_2_initial_image | image_url: width: 1200 }}"
                      {% endif %}
                      style="--gigi-swatch: {{ section.settings.product_2_color_1 }};"
                    ></button>

                    <button
                      class="gigi-compare__swatch"
                      type="button"
                      role="listitem"
                      aria-label="{{ section.settings.product_2_color_2_label | escape }}"
                      aria-pressed="false"
                      title="{{ section.settings.product_2_color_2_label | escape }}"
                      data-gigi-swatch
                      data-label="{{ section.settings.product_2_color_2_label | escape }}"
                      {% if section.settings.product_2_color_2_image != blank %}
                        data-image="{{ section.settings.product_2_color_2_image | image_url: width: 1200 }}"
                      {% endif %}
                      style="--gigi-swatch: {{ section.settings.product_2_color_2 }};"
                    ></button>
                  </div>
                </div>
              </div>
            </td>
          </tr>

          {% for block in section.blocks %}
            <tr {{ block.shopify_attributes }}>
              <th class="gigi-compare__sticky gigi-compare__label-cell" scope="row">
                {{ block.settings.label | escape }}
              </th>
              <td class="gigi-compare__highlight gigi-compare__value">
                {{ block.settings.product_1_value }}
              </td>
              <td class="gigi-compare__value">
                {{ block.settings.product_2_value }}
              </td>
            </tr>
          {% endfor %}
        </tbody>

        {% if section.settings.product_1_button_label != blank or section.settings.product_2_button_label != blank %}
          <tfoot>
            <tr>
              <td class="gigi-compare__sticky gigi-compare__label-cell"></td>
              <td class="gigi-compare__highlight">
                {% if section.settings.product_1_button_label != blank %}
                  <a class="gigi-compare__button" href="{{ section.settings.product_1_button_link | default: section.settings.product_1_link | default: '#' }}">
                    {{ section.settings.product_1_button_label | escape }}
                  </a>
                {% endif %}
              </td>
              <td>
                {% if section.settings.product_2_button_label != blank %}
                  <a class="gigi-compare__button" href="{{ section.settings.product_2_button_link | default: section.settings.product_2_link | default: '#' }}">
                    {{ section.settings.product_2_button_label | escape }}
                  </a>
                {% endif %}
              </td>
            </tr>
          </tfoot>
        {% endif %}
      </table>
    </div>

    {% if section.settings.note != blank %}
      <div class="gigi-compare__note">{{ section.settings.note }}</div>
    {% endif %}
  </div>
</section>

<style>
  #{{ section_id }} {
    background: var(--gigi-bg);
    color: var(--gigi-text);
    padding: var(--gigi-padding-top) 0 var(--gigi-padding-bottom);
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .gigi-compare__inner {
    width: min(100%, var(--gigi-max-width));
    margin: 0 auto;
    padding: 0 43px;
  }

  #{{ section_id }} .gigi-compare__heading {
    margin: 0 0 20px;
    color: var(--gigi-heading);
    font-size: clamp(30px, 3.2vw, 48px);
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: 0;
    text-align: center;
  }

  #{{ section_id }} .gigi-compare__scroller {
    position: relative;
    overflow-x: auto;
    overflow-y: visible;
    border-radius: var(--gigi-radius);
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  #{{ section_id }} .gigi-compare__scroller.is-scrolled .gigi-compare__sticky {
    box-shadow: 10px 0 18px rgba(0, 0, 0, .08);
  }

  #{{ section_id }} .gigi-compare__table {
    width: 100%;
    min-width: 760px;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--gigi-card-bg);
    color: var(--gigi-text);
  }

  #{{ section_id }} th,
  #{{ section_id }} td {
    width: 38%;
    padding: 18px 22px;
    border: 0;
    border-bottom: 1px solid var(--gigi-line);
    color: inherit;
    font-size: 16px;
    line-height: 1.45;
    text-align: center;
    vertical-align: middle;
  }

  #{{ section_id }} .gigi-compare__sticky {
    position: sticky;
    left: 0;
    z-index: 2;
    width: 24%;
    background: var(--gigi-card-bg);
    text-align: left;
    transition: box-shadow 180ms ease;
  }

  #{{ section_id }} thead .gigi-compare__sticky {
    z-index: 4;
  }

  #{{ section_id }} .gigi-compare__highlight {
    background: var(--gigi-column-bg);
  }

  #{{ section_id }} .gigi-compare__label-cell {
    color: var(--gigi-heading);
    font-weight: 650;
  }

  #{{ section_id }} .gigi-compare__product-heading {
    padding-top: 20px;
    padding-bottom: 20px;
    color: var(--gigi-heading);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
  }

  #{{ section_id }} .gigi-compare__product-heading a,
  #{{ section_id }} .gigi-compare__product-heading span {
    color: inherit;
    text-decoration: none;
  }

  #{{ section_id }} .gigi-compare__product-heading a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  #{{ section_id }} .gigi-compare__product-row td {
    padding-top: 22px;
    padding-bottom: 26px;
  }

  #{{ section_id }} .gigi-compare__product-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  #{{ section_id }} .gigi-compare__image-link {
    display: block;
    width: min(100%, 300px);
    aspect-ratio: 1 / 1;
    color: inherit;
    text-decoration: none;
  }

  #{{ section_id }} .gigi-compare__image,
  #{{ section_id }} .gigi-compare__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: calc(var(--gigi-radius) - 2px);
  }

  #{{ section_id }} .gigi-compare__image {
    object-fit: contain;
    object-position: center;
    mix-blend-mode: var(--gigi-image-blend);
    transition: opacity 180ms ease, transform 220ms ease;
  }

  #{{ section_id }} .gigi-compare__image.is-changing {
    opacity: .25;
    transform: scale(.985);
  }

  #{{ section_id }} .gigi-compare__placeholder {
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, .05);
    color: var(--gigi-muted);
    font-size: clamp(46px, 6vw, 86px);
    font-weight: 700;
  }

  #{{ section_id }} .gigi-compare__variants {
    display: grid;
    gap: 9px;
    justify-items: center;
  }

  #{{ section_id }} .gigi-compare__variant-name {
    min-height: 20px;
    color: var(--gigi-text);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }

  #{{ section_id }} .gigi-compare__swatches {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  #{{ section_id }} .gigi-compare__swatch {
    width: 22px;
    height: 22px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 50%;
    background: var(--gigi-swatch);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .13);
    cursor: pointer;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  #{{ section_id }} .gigi-compare__swatch:hover,
  #{{ section_id }} .gigi-compare__swatch.is-active {
    border-color: var(--gigi-heading);
    box-shadow: inset 0 0 0 2px var(--gigi-card-bg), 0 0 0 1px var(--gigi-heading);
  }

  #{{ section_id }} .gigi-compare__swatch:hover {
    transform: translateY(-1px);
  }

  #{{ section_id }} .gigi-compare__swatch:focus-visible,
  #{{ section_id }} .gigi-compare__button:focus-visible {
    outline: 2px solid var(--gigi-heading);
    outline-offset: 3px;
  }

  #{{ section_id }} .gigi-compare__value p {
    margin: 0;
  }

  #{{ section_id }} .gigi-compare__value p + p {
    margin-top: 4px;
  }

  #{{ section_id }} tfoot td {
    border-bottom: 0;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  #{{ section_id }} .gigi-compare__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    min-width: 138px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--gigi-button-bg);
    color: var(--gigi-button-text);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  #{{ section_id }} .gigi-compare__button:hover {
    background: var(--gigi-button-hover-bg);
    color: var(--gigi-button-hover-text);
    transform: translateY(-1px);
  }

  #{{ section_id }} .gigi-compare__note {
    margin-top: 10px;
    color: var(--gigi-muted);
    font-size: 13px;
    line-height: 1.45;
  }

  #{{ section_id }} .gigi-compare__note p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .gigi-compare__inner {
      padding: 0 24px;
    }

    #{{ section_id }} .gigi-compare__table {
      min-width: 690px;
    }

    #{{ section_id }} th,
    #{{ section_id }} td {
      padding: 15px 16px;
      font-size: 15px;
    }

    #{{ section_id }} .gigi-compare__product-heading {
      font-size: 20px;
    }

    #{{ section_id }} .gigi-compare__image-link {
      width: 230px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: calc(var(--gigi-padding-top) * .72);
      padding-bottom: calc(var(--gigi-padding-bottom) * .72);
    }

    #{{ section_id }} .gigi-compare__inner {
      padding: 0 10px;
    }

    #{{ section_id }} .gigi-compare__heading {
      margin-bottom: 14px;
      font-size: 26px;
    }

    #{{ section_id }} .gigi-compare__scroller {
      overflow-x: visible;
      border-radius: var(--gigi-radius);
    }

    #{{ section_id }} .gigi-compare__table {
      width: 100%;
      min-width: 0;
      border-radius: var(--gigi-radius);
      overflow: hidden;
    }

    #{{ section_id }} th,
    #{{ section_id }} td {
      width: 37%;
      padding: 10px 6px;
      font-size: 12px;
      line-height: 1.32;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    #{{ section_id }} .gigi-compare__sticky {
      position: static;
      width: 26%;
      min-width: 0;
      box-shadow: none;
    }

    #{{ section_id }} .gigi-compare__product-heading {
      font-size: 14px;
      line-height: 1.18;
    }

    #{{ section_id }} .gigi-compare__product-row td {
      padding-top: 12px;
      padding-bottom: 14px;
    }

    #{{ section_id }} .gigi-compare__image-link {
      width: min(100%, 118px);
    }

    #{{ section_id }} .gigi-compare__product-card {
      gap: 10px;
    }

    #{{ section_id }} .gigi-compare__variant-name {
      min-height: 16px;
      font-size: 11px;
    }

    #{{ section_id }} .gigi-compare__swatches {
      gap: 6px;
    }

    #{{ section_id }} .gigi-compare__swatch {
      width: 18px;
      height: 18px;
    }

    #{{ section_id }} .gigi-compare__button {
      width: 100%;
      min-width: 0;
      min-height: 34px;
      padding: 0 8px;
      font-size: 11px;
      white-space: normal;
      line-height: 1.15;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .gigi-compare__image,
    #{{ section_id }} .gigi-compare__swatch,
    #{{ section_id }} .gigi-compare__button,
    #{{ section_id }} .gigi-compare__sticky {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const initGigiCompare = (root) => {
      if (!root || root.dataset.gigiReady === 'true') return;
      root.dataset.gigiReady = 'true';

      const scroller = root.querySelector('[data-gigi-scroller]');
      const cards = Array.from(root.querySelectorAll('[data-gigi-product-card]'));

      const updateScrollState = () => {
        if (!scroller) return;
        scroller.classList.toggle('is-scrolled', scroller.scrollLeft > 2);
      };

      cards.forEach((card) => {
        const swatches = Array.from(card.querySelectorAll('[data-gigi-swatch]'));
        const label = card.querySelector('[data-gigi-variant-name]');
        const image = card.querySelector('[data-gigi-product-image]');

        const setActive = (swatch) => {
          swatches.forEach((item) => {
            const isActive = item === swatch;
            item.classList.toggle('is-active', isActive);
            item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });

          if (label) label.textContent = swatch.dataset.label || '';

          const nextImage = swatch.dataset.image;
          if (nextImage && image && image.tagName === 'IMG' && image.getAttribute('src') !== nextImage) {
            image.classList.add('is-changing');
            window.setTimeout(() => {
              image.setAttribute('src', nextImage);
              image.removeAttribute('srcset');
              image.removeAttribute('sizes');
              image.classList.remove('is-changing');
            }, 120);
          }
        };

        swatches.forEach((swatch, index) => {
          swatch.addEventListener('click', () => setActive(swatch));
          if (index === 0) setActive(swatch);
        });
      });

      scroller?.addEventListener('scroll', updateScrollState, { passive: true });
      updateScrollState();
    };

    document.querySelectorAll('[data-gigi-compare]').forEach(initGigiCompare);

    document.addEventListener('shopify:section:load', (event) => {
      initGigiCompare(event.target.querySelector('[data-gigi-compare]'));
    });
  })();
</script>

{% schema %}
{
  "name": "Gigi compare table",
  "tag": "section",
  "class": "section-gigi-compare",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare Ebikes"
    },
    {
      "type": "text",
      "id": "model_label",
      "label": "First column label",
      "default": "Model"
    },
    {
      "type": "header",
      "content": "Product 1"
    },
    {
      "type": "text",
      "id": "product_1_title",
      "label": "Title",
      "default": "Summit 2"
    },
    {
      "type": "url",
      "id": "product_1_link",
      "label": "Product link"
    },
    {
      "type": "image_picker",
      "id": "product_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "product_1_image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "product_1_color_1_label",
      "label": "Color 1 label",
      "default": "Galaxy Purple"
    },
    {
      "type": "color",
      "id": "product_1_color_1",
      "label": "Color 1 swatch",
      "default": "#3C225F"
    },
    {
      "type": "image_picker",
      "id": "product_1_color_1_image",
      "label": "Color 1 image"
    },
    {
      "type": "text",
      "id": "product_1_color_2_label",
      "label": "Color 2 label",
      "default": "Glacial Silver"
    },
    {
      "type": "color",
      "id": "product_1_color_2",
      "label": "Color 2 swatch",
      "default": "#AFAFB1"
    },
    {
      "type": "image_picker",
      "id": "product_1_color_2_image",
      "label": "Color 2 image"
    },
    {
      "type": "text",
      "id": "product_1_button_label",
      "label": "Button label",
      "default": "Explore Ebike"
    },
    {
      "type": "url",
      "id": "product_1_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Product 2"
    },
    {
      "type": "text",
      "id": "product_2_title",
      "label": "Title",
      "default": "Summit 1"
    },
    {

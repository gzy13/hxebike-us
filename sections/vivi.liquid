{% liquid
  assign sid = section.id
  assign desktop_video = section.settings.motor_video_desktop
  assign mobile_video = section.settings.motor_video_mobile | default: desktop_video
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_color = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha
%}

<section
  id="ViviMosaic-{{ sid }}"
  class="vivi-mosaic"
  style="
    --vivi-bg: {{ section.settings.background_color }};
    --vivi-text: {{ section.settings.text_color }};
    --vivi-overlay-color: {{ overlay_color }};
    --vivi-button-bg: {{ section.settings.button_background }};
    --vivi-button-text: {{ section.settings.button_text_color }};
    --vivi-radius: {{ section.settings.corner_radius }}px;
    --vivi-max-width: {{ section.settings.max_width }}px;
    --vivi-padding-top: {{ section.settings.padding_top }}px;
    --vivi-padding-bottom: {{ section.settings.padding_bottom }}px;
    --vivi-mobile-padding-top: {{ section.settings.mobile_padding_top | default: 24 }}px;
    --vivi-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom | default: 24 }}px;
    --vivi-mobile-video-height: {{ section.settings.mobile_video_height | default: 560 }}px;
    --vivi-mobile-image-height: {{ section.settings.mobile_image_height | default: 300 }}px;
  "
>
  <div class="vivi-mosaic__wrap">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="vivi-mosaic__header">
        {% if section.settings.heading != blank %}
          <h2 class="vivi-mosaic__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="vivi-mosaic__subheading">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="vivi-mosaic__grid">
      <div class="vivi-mosaic__col vivi-mosaic__col--1">
        <div class="vivi-mosaic__item vivi-mosaic__item--motor vivi-mosaic__item--video" aria-label="{{ section.settings.motor_aria_label | escape }}" tabindex="0">
          <div class="vivi-mosaic__media">
            {% if section.settings.motor_poster_desktop != blank %}
              {% assign motor_poster_desktop = section.settings.motor_poster_desktop | image_url: width: 1400 %}
            {% endif %}

            {% if section.settings.motor_poster_mobile != blank %}
              {% assign motor_poster_mobile = section.settings.motor_poster_mobile | image_url: width: 900 %}
            {% else %}
              {% assign motor_poster_mobile = motor_poster_desktop %}
            {% endif %}

            {% if desktop_video != blank %}
              <video
                class="vivi-mosaic__visual vivi-mosaic__visual--desktop vivi-mosaic__video"
                playsinline
                loop
                muted
                preload="metadata"
                autoplay
                {% if motor_poster_desktop != blank %}poster="{{ motor_poster_desktop }}"{% endif %}
              >
                <source src="{{ desktop_video }}" type="video/mp4">
                {% if motor_poster_desktop != blank %}
                  <img src="{{ motor_poster_desktop }}" alt="{{ section.settings.motor_aria_label | escape }}" loading="lazy">
                {% endif %}
              </video>
            {% elsif section.settings.motor_poster_desktop != blank %}
              <img class="vivi-mosaic__visual vivi-mosaic__visual--desktop" src="{{ section.settings.motor_poster_desktop | image_url: width: 1400 }}" alt="{{ section.settings.motor_aria_label | escape }}" loading="lazy" width="{{ section.settings.motor_poster_desktop.width }}" height="{{ section.settings.motor_poster_desktop.height }}">
            {% endif %}

            {% if mobile_video != blank %}
              <video
                class="vivi-mosaic__visual vivi-mosaic__visual--mobile vivi-mosaic__video"
                playsinline
                loop
                muted
                preload="metadata"
                autoplay
                {% if motor_poster_mobile != blank %}poster="{{ motor_poster_mobile }}"{% endif %}
              >
                <source src="{{ mobile_video }}" type="video/mp4">
                {% if motor_poster_mobile != blank %}
                  <img src="{{ motor_poster_mobile }}" alt="{{ section.settings.motor_aria_label | escape }}" loading="lazy">
                {% endif %}
              </video>
            {% elsif section.settings.motor_poster_mobile != blank %}
              <img class="vivi-mosaic__visual vivi-mosaic__visual--mobile" src="{{ section.settings.motor_poster_mobile | image_url: width: 900 }}" alt="{{ section.settings.motor_aria_label | escape }}" loading="lazy" width="{{ section.settings.motor_poster_mobile.width }}" height="{{ section.settings.motor_poster_mobile.height }}">
            {% elsif section.settings.motor_poster_desktop != blank %}
              <img class="vivi-mosaic__visual vivi-mosaic__visual--mobile" src="{{ section.settings.motor_poster_desktop | image_url: width: 900 }}" alt="{{ section.settings.motor_aria_label | escape }}" loading="lazy" width="{{ section.settings.motor_poster_desktop.width }}" height="{{ section.settings.motor_poster_desktop.height }}">
            {% endif %}

            {% if desktop_video == blank and section.settings.motor_poster_desktop == blank %}
              <div class="vivi-mosaic__placeholder">Upload video or poster image</div>
            {% endif %}
          </div>
          <div class="vivi-mosaic__shade"></div>
          <div class="vivi-mosaic__text">
            <div class="vivi-mosaic__kpi vivi-mosaic__kpi--three">
              <div>
                <div class="vivi-mosaic__kpi-title"><strong>{{ section.settings.motor_stat_1_value | escape }}</strong></div>
                <div class="vivi-mosaic__kpi-des">{{ section.settings.motor_stat_1_label | escape }}</div>
              </div>
              <div>
                <div class="vivi-mosaic__kpi-title"><strong>{{ section.settings.motor_stat_2_value | escape }}</strong> {{ section.settings.motor_stat_2_unit | escape }}</div>
                <div class="vivi-mosaic__kpi-des">{{ section.settings.motor_stat_2_label | escape }}</div>
              </div>
              <div>
                <div class="vivi-mosaic__kpi-title"><strong>{{ section.settings.motor_stat_3_value | escape }}</strong> {{ section.settings.motor_stat_3_unit | escape }}</div>
                <div class="vivi-mosaic__kpi-des">{{ section.settings.motor_stat_3_label | escape }}</div>
              </div>
            </div>
            {% if section.settings.motor_button_label != blank %}
              <a class="vivi-mosaic__button" href="{{ section.settings.motor_button_link | default: '#' }}">{{ section.settings.motor_button_label | escape }}</a>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="vivi-mosaic__col vivi-mosaic__col--2">
        <div class="vivi-mosaic__item vivi-mosaic__item--range">
          <div class="vivi-mosaic__media">
            {% if section.settings.range_image_desktop != blank %}
              <img class="vivi-mosaic__visual vivi-mosaic__visual--desktop" src="{{ section.settings.range_image_desktop | image_url: width: 1400 }}" alt="{{ section.settings.range_title | escape }}" loading="lazy" width="{{ section.settings.range_image_desktop.width }}" height="{{ section.settings.range_image_desktop.height }}">
            {% endif %}

            {% if section.settings.range_image_mobile != blank %}
              <img class="vivi-mosaic__visual vivi-mosaic__visual--mobile" src="{{ section.settings.range_image_mobile | image_url: width: 900 }}" alt="{{ section.settings.range_title | escape }}" loading="lazy" width="{{ section.settings.range_image_mobile.width }}" height="{{ section.settings.range_image_mobile.height }}">
            {% elsif section.settings.range_image_desktop != blank %}
              <img class="vivi-mosaic__visual vivi-mosaic__visual--mobile" src="{{ section.settings.range_image_desktop | image_url: width: 900 }}" alt="{{ section.settings.range_title | escape }}" loading="lazy" width="{{ section.settings.range_image_desktop.width }}" height="{{ section.settings.range_image_desktop.height }}">
            {% endif %}

            {% if section.settings.range_image_desktop == blank %}
              <div class="vivi-mosaic__placeholder">Upload image</div>
            {% endif %}
          </div>
          <div class="vivi-mosaic__shade"></div>
          <div class="vivi-mosaic__text">
            <div class="vivi-mosaic__kpi">
              <div>
                <div class="vivi-mosaic__kpi-title">{{ section.settings.range_title | escape }}</div>
              </div>
            </div>
            {% if section.settings.range_button_label != blank %}
              <a class="vivi-mosaic__button" href="{{ section.settings.range_button_link | default: '#' }}">{{ section.settings.range_button_label | escape }}</a>
            {% endif %}
          </div>
        </div>

        <div class="vivi-mosaic__item vivi-mosaic__item--payload">
          <div class="vivi-mosaic__media">
            {% if section.settings.comfort_image_desktop != blank %}
              <img class="vivi-mosaic__visual vivi-mosaic__visual--desktop" src="{{ section.settings.comfort_image_desktop | image_url: width: 1400 }}" alt="{{ section.settings.comfort_title | escape }}" loading="lazy" width="{{ section.settings.comfort_image_desktop.width }}" height="{{ section.settings.comfort_image_desktop.height }}">
            {% endif %}

            {% if section.settings.comfort_image_mobile != blank %}
              <img class="vivi-mosaic__visual vivi-mosaic__visual--mobile" src="{{ section.settings.comfort_image_mobile | image_url: width: 900 }}" alt="{{ section.settings.comfort_title | escape }}" loading="lazy" width="{{ section.settings.comfort_image_mobile.width }}" height="{{ section.settings.comfort_image_mobile.height }}">
            {% elsif section.settings.comfort_image_desktop != blank %}
              <img class="vivi-mosaic__visual vivi-mosaic__visual--mobile" src="{{ section.settings.comfort_image_desktop | image_url: width: 900 }}" alt="{{ section.settings.comfort_title | escape }}" loading="lazy" width="{{ section.settings.comfort_image_desktop.width }}" height="{{ section.settings.comfort_image_desktop.height }}">
            {% endif %}

            {% if section.settings.comfort_image_desktop == blank %}
              <div class="vivi-mosaic__placeholder">Upload image</div>
            {% endif %}
          </div>
          <div class="vivi-mosaic__shade"></div>
          <div class="vivi-mosaic__text">
            <div class="vivi-mosaic__kpi">
              <div>
                <div class="vivi-mosaic__kpi-title">{{ section.settings.comfort_title | escape }}</div>
                {% if section.settings.comfort_list != blank %}
                  <ul>
                    {% assign comfort_items = section.settings.comfort_list | newline_to_br | split: '<br />' %}
                    {% for item in comfort_items %}
                      {% assign trimmed_item = item | strip %}
                      {% if trimmed_item != blank %}
                        <li>{{ trimmed_item | escape }}</li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </div>
            {% if section.settings.comfort_button_label != blank %}
              <a class="vivi-mosaic__button" href="{{ section.settings.comfort_button_link | default: '#' }}">{{ section.settings.comfort_button_label | escape }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #ViviMosaic-{{ sid }} {
    background: var(--vivi-bg);
    color: var(--vivi-text);
    padding-block: var(--vivi-padding-top) var(--vivi-padding-bottom);
  }

  #ViviMosaic-{{ sid }} * {
    box-sizing: border-box;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__wrap {
    width: 100%;
    max-width: var(--vivi-max-width);
    margin: 0 auto;
    padding-inline: 43px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__header {
    display: grid;
    gap: 10px;
    max-width: 760px;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__heading {
    margin: 0;
    color: var(--vivi-text);
    font-family: inherit;
    font-size: 36px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: 0;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__subheading {
    color: var(--vivi-text);
    opacity: 0.78;
    font-size: 16px;
    line-height: 1.5;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__subheading > * {
    margin: 0;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.965fr);
    gap: 16px;
    min-height: 650px;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__col {
    min-width: 0;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__col--2 {
    display: grid;
    gap: 16px;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__item {
    position: relative;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--vivi-radius);
    background: #121315;
    isolation: isolate;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__item--range,
  #ViviMosaic-{{ sid }} .vivi-mosaic__item--payload {
    background: transparent;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__media,
  #ViviMosaic-{{ sid }} .vivi-mosaic__visual {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__visual {
    display: block;
    object-fit: cover;
    object-position: center;
    transform: scale(1);
    transition: transform 700ms ease;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__item:hover .vivi-mosaic__visual,
  #ViviMosaic-{{ sid }} .vivi-mosaic__item:focus-visible .vivi-mosaic__visual {
    transform: scale(1.035);
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #f3f3f3;
    color: #777;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0) 38%, rgba(0, 0, 0, 0.52) 100%),
      linear-gradient(0deg, var(--vivi-overlay-color), var(--vivi-overlay-color));
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__item--range .vivi-mosaic__shade,
  #ViviMosaic-{{ sid }} .vivi-mosaic__item--payload .vivi-mosaic__shade {
    display: none;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: 30px;
    color: #fff;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__kpi {
    display: flex;
    gap: 34px;
    align-items: flex-start;
    min-width: 0;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__kpi--three {
    width: 100%;
    justify-content: space-between;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__kpi-title {
    font-size: 24px;
    line-height: 1.18;
    font-weight: 500;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__kpi-title strong {
    font-size: 46px;
    line-height: 0.96;
    font-weight: 800;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__kpi-des {
    margin-top: 7px;
    font-size: 15px;
    line-height: 1.35;
    opacity: 0.86;
  }

  #ViviMosaic-{{ sid }} ul {
    margin: 12px 0 0;
    padding-left: 20px;
    font-size: 16px;
    line-height: 1.55;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 11px 20px;
    border-radius: 999px;
    background: var(--vivi-button-bg);
    color: var(--vivi-button-text);
    font-size: 14px;
    line-height: 1;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__button:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  #ViviMosaic-{{ sid }} .vivi-mosaic__visual--mobile {
    display: none;
  }

  @media (max-width: 989px) {
    #ViviMosaic-{{ sid }} {
      padding-block: var(--vivi-mobile-padding-top) var(--vivi-mobile-padding-bottom);
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__wrap {
      padding-inline: 20px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__grid {
      grid-template-columns: 1fr;
      gap: 12px;
      min-height: 0;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__col--2 {
      gap: 12px;
      grid-template-rows: none;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__item {
      height: auto;
      min-height: var(--vivi-mobile-video-height);
      aspect-ratio: auto;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__item--range,
    #ViviMosaic-{{ sid }} .vivi-mosaic__item--payload {
      min-height: var(--vivi-mobile-image-height);
      aspect-ratio: auto;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__text {
      padding: 24px;
    }
  }

  @media (max-width: 749px) {
    #ViviMosaic-{{ sid }} .vivi-mosaic__wrap {
      padding-inline: 12px;
      gap: 12px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__heading {
      font-size: 28px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__visual--desktop {
      display: none;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__visual--mobile {
      display: block;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__item {
      border-radius: min(var(--vivi-radius), 18px);
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__item--range,
    #ViviMosaic-{{ sid }} .vivi-mosaic__item--payload {
      min-height: var(--vivi-mobile-image-height);
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__text {
      display: grid;
      align-items: end;
      gap: 12px;
      padding: 18px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi,
    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi--three {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      width: 100%;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__item--range .vivi-mosaic__kpi,
    #ViviMosaic-{{ sid }} .vivi-mosaic__item--payload .vivi-mosaic__kpi {
      grid-template-columns: 1fr;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi-title {
      font-size: 18px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi-title strong {
      font-size: 28px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi-des {
      font-size: 13px;
    }

    #ViviMosaic-{{ sid }} ul {
      font-size: 15px;
    }
  }

  @media (max-width: 420px) {
    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi,
    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi--three {
      gap: 10px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi-title {
      font-size: 15px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi-title strong {
      font-size: 23px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__text {
      padding: 16px;
    }

    #ViviMosaic-{{ sid }} .vivi-mosaic__kpi-des {
      font-size: 12px;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('ViviMosaic-{{ sid }}');
    if (!root) return;

    var videos = root.querySelectorAll('.vivi-mosaic__video');
    videos.forEach(function (video) {
      video.muted = true;
      video.playsInline = true;

      var play = function () {
        var promise = video.play();
        if (promise && typeof promise.catch === 'function') {
          promise.catch(function () {});
        }
      };

      if (video.readyState >= 2) {
        play();
      } else {
        video.addEventListener('loadedmetadata', play, { once: true });
      }
    });

    root.querySelectorAll('.vivi-mosaic__item--video').forEach(function (card) {
      card.addEventListener('click', function () {
        var activeVideo = window.matchMedia('(max-width: 749px)').matches
          ? card.querySelector('.vivi-mosaic__visual--mobile')
          : card.querySelector('.vivi-mosaic__visual--desktop');

        if (!activeVideo) return;
        if (activeVideo.paused) {
          activeVideo.play();
        } else {
          activeVideo.pause();
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Vivi mosaic media",
  "settings": [
    { "type": "header", "content": "Section" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "max_width", "label": "Max width", "min": 960, "max": 1600, "step": 20, "unit": "px", "default": 1300 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "mobile_padding_top", "label": "Mobile top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Mobile bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_video_height", "label": "Mobile video card height", "min": 360, "max": 720, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "mobile_image_height", "label": "Mobile image card height", "min": 240, "max": 560, "step": 20, "unit": "px", "default": 300 },
    { "type": "range", "id": "corner_radius", "label": "Card corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 24 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Heading text", "default": "#121315" },
    { "type": "color", "id": "overlay_color", "label": "Image overlay", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 70, "step": 1, "unit": "%", "default": 8 },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#121315" },

    { "type": "header", "content": "Left video card" },
    { "type": "text", "id": "motor_aria_label", "label": "Video accessibility label", "default": "750W Motor video" },
    { "type": "text", "id": "motor_video_desktop", "label": "Desktop MP4 URL" },
    { "type": "text", "id": "motor_video_mobile", "label": "Mobile MP4 URL" },
    { "type": "image_picker", "id": "motor_poster_desktop", "label": "Desktop poster image" },

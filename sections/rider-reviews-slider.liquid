{% comment %}
  Rider Reviews Video Slider Section - Optimized Final
  优化内容：
  1) controls 保持在 swiper 外部，避免裁切
  2) 修复 lightbox 关闭按钮定位
  3) 更稳健的 YouTube ID 提取（Liquid + JS 双保险）
  4) 进度条按“可滑动页数”计算，更直观
  5) 支持键盘操作（Enter / Space / Escape）
  6) 防止 Theme Editor / section 重载时重复初始化
  7) 无头像时显示首字母占位
  8) 增强可访问性与代码稳健性
{% endcomment %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<style>
  .rider-reviews-wrapper-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top }}px;
    padding: 60px 20px;
    background: #fff;
    overflow: visible;
  }

  .rider-reviews-container-{{ section.id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .rider-reviews-header-{{ section.id }} {
    text-align: left;
    margin-bottom: 32px;
  }

  .rider-reviews-title-{{ section.id }} {
    font-size: 2rem;
    font-weight: 700;
    color: #000;
    margin: 0 0 6px;
  }

  .rider-reviews-subtitle-{{ section.id }} {
    font-size: 0.95rem;
    color: #666;
    margin: 0;
  }

  .swiper-container-{{ section.id }} {
    position: relative;
    padding-bottom: 0;
  }

  .swiper-wrapper-{{ section.id }} {
    display: flex;
  }

  .swiper-slide-{{ section.id }} {
    height: auto;
  }

  .video-card-{{ section.id }} {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    height: 100%;
    display: flex;
    flex-direction: column;
    outline: none;
  }

  .video-card-{{ section.id }}:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 30px rgba(0,0,0,0.16);
  }

  .video-card-{{ section.id }}:focus-visible {
    box-shadow:
      0 14px 30px rgba(0,0,0,0.16),
      0 0 0 3px rgba(0,0,0,0.2);
  }

  .video-thumbnail-wrapper-{{ section.id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    overflow: hidden;
    background: #000;
  }

  .video-thumbnail-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-button-overlay-{{ section.id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70px;
    height: 70px;
    transition: transform 0.3s ease;
    pointer-events: none;
    z-index: 2;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
  }

  .video-card-{{ section.id }}:hover .play-button-overlay-{{ section.id }},
  .video-card-{{ section.id }}:focus-visible .play-button-overlay-{{ section.id }} {
    transform: translate(-50%, -50%) scale(1.12);
  }

  .video-info-{{ section.id }} {
    padding: 18px 20px 20px;
  }

  .video-title-{{ section.id }} {
    font-size: 1rem;
    font-weight: 500;
    color: #000;
    margin: 0 0 10px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 42px;
  }

  .video-views-{{ section.id }} {
    font-size: 0.85rem;
    color: #666;
    margin: 0 0 10px;
  }

  .video-meta-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .reviewer-avatar-{{ section.id }},
  .reviewer-avatar-placeholder-{{ section.id }} {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 34px;
  }

  .reviewer-avatar-placeholder-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .reviewer-name-{{ section.id }} {
    font-size: 0.9rem;
    font-weight: 600;
    color: #333;
    line-height: 1.3;
  }

  .slider-controls-{{ section.id }} {
    margin-top: 14px;
    padding: 0 4px 4px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .slider-progress-track-{{ section.id }} {
    flex: 1;
    height: 4px;
    background: #e0e0e0;
    border-radius: 2px;
    overflow: hidden;
  }

  .slider-progress-fill-{{ section.id }} {
    width: 0%;
    height: 100%;
    background: {{ section.settings.progress_bar_color }};
    transition: width 0.3s ease;
  }

  .slider-arrows-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .slider-arrow-{{ section.id }} {
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    border-radius: 50%;
    border: none;
    background: {{ section.settings.arrow_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    padding: 0;
  }

  .slider-arrow-{{ section.id }} svg {
    width: calc({{ section.settings.arrow_size }}px * 0.4);
    height: calc({{ section.settings.arrow_size }}px * 0.4);
    fill: #fff;
  }

  .slider-arrow-{{ section.id }}:hover {
    background: #000;
    transform: scale(1.07);
  }

  .slider-arrow-{{ section.id }}:focus-visible {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  .slider-arrow-{{ section.id }}.swiper-button-disabled,
  .slider-arrow-{{ section.id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none;
  }

  /* === Lightbox === */
  .video-lightbox-{{ section.id }} {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    z-index: 99999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .video-lightbox-{{ section.id }}.active {
    display: flex;
  }

  .lightbox-content-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: 1200px;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
  }

  .lightbox-close-{{ section.id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    background: rgba(0, 0, 0, 0.45);
    border: none;
    color: #fff;
    font-size: 30px;
    cursor: pointer;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease;
    line-height: 1;
    padding: 0;
  }

  .lightbox-close-{{ section.id }}:hover {
    transform: scale(1.08);
    background: rgba(0, 0, 0, 0.65);
  }

  .lightbox-close-{{ section.id }}:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .lightbox-iframe-{{ section.id }} {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  @media (max-width: 768px) {
    .rider-reviews-wrapper-{{ section.id }} {
      padding: 40px 16px 48px;
    }

    .rider-reviews-title-{{ section.id }} {
      font-size: 1.5rem;
    }

    .video-card-{{ section.id }} {
      border-radius: 16px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }

    .video-info-{{ section.id }} {
      padding: 16px 16px 18px;
    }

    .video-title-{{ section.id }} {
      font-size: 0.96rem;
      min-height: 40px;
    }

    .video-views-{{ section.id }} {
      font-size: 0.82rem;
    }

    .slider-arrow-{{ section.id }} {
      width: 32px;
      height: 32px;
    }

    .slider-arrow-{{ section.id }} svg {
      width: 12px;
      height: 12px;
    }

    .slider-controls-{{ section.id }} {
      margin-top: 12px;
      padding: 0 2px 2px;
    }

    .lightbox-close-{{ section.id }} {
      top: 8px;
      right: 8px;
      width: 36px;
      height: 36px;
      font-size: 26px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .rider-reviews-title-{{ section.id }} {
      font-size: 1.75rem;
    }
  }

  /* 仅桌面端放宽宽度 */
  @media (min-width: 1025px) {
    .rider-reviews-container-{{ section.id }} {
      max-width: 1680px;
    }

    .rider-reviews-wrapper-{{ section.id }} {
      padding-left: 12px;
      padding-right: 12px;
    }
  }
</style>

<section
  class="rider-reviews-wrapper-{{ section.id }}"
  id="rider-reviews-section-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="rider-reviews-container-{{ section.id }}">
    {% if section.settings.section_title != blank %}
      <div class="rider-reviews-header-{{ section.id }}">
        <h2 class="rider-reviews-title-{{ section.id }}">{{ section.settings.section_title }}</h2>
        {% if section.settings.section_subtitle != blank %}
          <p class="rider-reviews-subtitle-{{ section.id }}">{{ section.settings.section_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="swiper swiper-container-{{ section.id }}">
      <div class="swiper-wrapper swiper-wrapper-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'video_card' %}
            {% assign video_url = block.settings.youtube_url | default: '' %}
            {% assign video_id = '' %}

            {% if video_url contains 'watch?v=' %}
              {% assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first %}
            {% elsif video_url contains 'youtu.be/' %}
              {% assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first %}
            {% elsif video_url contains '/embed/' %}
              {% assign video_id = video_url | split: '/embed/' | last | split: '?' | first | split: '&' | first %}
            {% elsif video_url contains '/shorts/' %}
              {% assign video_id = video_url | split: '/shorts/' | last | split: '?' | first | split: '&' | first %}
            {% endif %}

            {% assign reviewer_initial = block.settings.reviewer_name | strip | slice: 0, 1 | upcase %}

            <div class="swiper-slide swiper-slide-{{ section.id }}" {{ block.shopify_attributes }}>
              <div
                class="video-card-{{ section.id }}"
                data-video-url="{{ video_url | escape }}"
                tabindex="0"
                role="button"
                aria-label="Play {{ block.settings.video_title | escape }}"
              >
                <div class="video-thumbnail-wrapper-{{ section.id }}">
                  {% if block.settings.custom_thumbnail != blank %}
                    <img
                      src="{{ block.settings.custom_thumbnail | image_url: width: 800 }}"
                      alt="{{ block.settings.video_title | escape }}"
                      class="video-thumbnail-{{ section.id }}"
                      loading="lazy"
                    >
                  {% elsif video_id != blank %}
                    <img
                      src="https://img.youtube.com/vi/{{ video_id }}/maxresdefault.jpg"
                      alt="{{ block.settings.video_title | escape }}"
                      class="video-thumbnail-{{ section.id }}"
                      loading="lazy"
                      onerror="this.onerror=null;this.src='https://img.youtube.com/vi/{{ video_id }}/hqdefault.jpg';"
                    >
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'video-thumbnail-' | replace: 'video-thumbnail-', 'video-thumbnail-' | append: section.id }}
                  {% endif %}

                  {% if block.settings.play_button != blank %}
                    <img
                      src="{{ block.settings.play_button | image_url: width: 140 }}"
                      alt=""
                      aria-hidden="true"
                      class="play-button-overlay-{{ section.id }}"
                      loading="lazy"
                    >
                  {% else %}
                    <svg class="play-button-overlay-{{ section.id }}" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      <circle cx="40" cy="40" r="40" fill="white" fill-opacity="0.96"/>
                      <path d="M32 26L56 40L32 54V26Z" fill="#FFCC00"/>
                    </svg>
                  {% endif %}
                </div>

                <div class="video-info-{{ section.id }}">
                  <h3 class="video-title-{{ section.id }}">{{ block.settings.video_title }}</h3>

                  {% if block.settings.view_count != blank %}
                    <p class="video-views-{{ section.id }}">{{ block.settings.view_count }}</p>
                  {% endif %}

                  <div class="video-meta-{{ section.id }}">
                    {% if block.settings.reviewer_avatar != blank %}
                      <img
                        src="{{ block.settings.reviewer_avatar | image_url: width: 72 }}"
                        alt="{{ block.settings.reviewer_name | escape }}"
                        class="reviewer-avatar-{{ section.id }}"
                        loading="lazy"
                      >
                    {% else %}
                      <div
                        class="reviewer-avatar-placeholder-{{ section.id }}"
                        aria-hidden="true"
                      >
                        {{ reviewer_initial | default: '?' }}
                      </div>
                    {% endif %}

                    <div class="reviewer-name-{{ section.id }}">
                      {{ block.settings.reviewer_name }}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="slider-controls-{{ section.id }}">
      <div class="slider-progress-track-{{ section.id }}" aria-hidden="true">
        <div class="slider-progress-fill-{{ section.id }}"></div>
      </div>

      <div class="slider-arrows-{{ section.id }}">
        <button
          class="slider-arrow-{{ section.id }} slider-arrow-prev-{{ section.id }}"
          type="button"
          aria-label="Previous"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M14.7 5.3a1 1 0 0 1 0 1.4L10.41 11l4.3 4.3a1 1 0 0 1-1.42 1.4l-5-5a1 1 0 0 1 0-1.4l5-5a1 1 0 0 1 1.41 0Z"/>
          </svg>
        </button>

        <button
          class="slider-arrow-{{ section.id }} slider-arrow-next-{{ section.id }}"
          type="button"
          aria-label="Next"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9.3 18.7a1 1 0 0 1 0-1.4L13.59 13l-4.3-4.3A1 1 0 0 1 10.71 7.3l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.41 0Z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    class="video-lightbox-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-label="Video player"
    aria-hidden="true"
  >
    <div class="lightbox-content-{{ section.id }}">
      <button
        class="lightbox-close-{{ section.id }}"
        type="button"
        aria-label="Close video"
      >&times;</button>

      <iframe
        class="lightbox-iframe-{{ section.id }}"
        src=""
        title="YouTube video player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen>
      </iframe>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var sectionKey = 'riderReviewsInit_' + sectionId;

  if (window[sectionKey]) return;
  window[sectionKey] = true;

  var root = document.getElementById('rider-reviews-section-' + sectionId);
  if (!root) return;

  var swiperEl = root.querySelector('.swiper-container-' + sectionId);
  var fillEl = root.querySelector('.slider-progress-fill-' + sectionId);
  var prevEl = root.querySelector('.slider-arrow-prev-' + sectionId);
  var nextEl = root.querySelector('.slider-arrow-next-' + sectionId);
  var lightbox = root.querySelector('.video-lightbox-' + sectionId);
  var lightboxIframe = root.querySelector('.lightbox-iframe-' + sectionId);
  var closeBtn = root.querySelector('.lightbox-close-' + sectionId);
  var videoCards = root.querySelectorAll('.video-card-' + sectionId);

  if (!swiperEl || !lightbox || !lightboxIframe || !closeBtn) return;

  function getYouTubeVideoId(url) {
    if (!url || typeof url !== 'string') return null;

    url = url.trim();

    var patterns = [
      /[?&]v=([^&#]{11})/,
      /youtu\.be\/([^?&#\/]{11})/,
      /youtube\.com\/embed\/([^?&#\/]{11})/,
      /youtube\.com\/shorts\/([^?&#\/]{11})/
    ];

    for (var i = 0; i < patterns.length; i++) {
      var match = url.match(patterns[i]);
      if (match && match[1]) return match[1];
    }

    return null;
  }

  function getCurrentSlidesPerView(swiperInstance) {
    var spv = swiperInstance.params.slidesPerView;

    if (spv === 'auto') return 1;
    if (typeof spv === 'number') return spv;

    var currentBreakpoint = swiperInstance.currentBreakpoint;
    if (
      currentBreakpoint &&
      swiperInstance.params.breakpoints &&
      swiperInstance.params.breakpoints[currentBreakpoint] &&
      swiperInstance.params.breakpoints[currentBreakpoint].slidesPerView
    ) {
      return swiperInstance.params.breakpoints[currentBreakpoint].slidesPerView;
    }

    return 1;
  }

  function updateProgress(swiperInstance) {
    if (!fillEl) return;

    var totalSlides = swiperInstance.slides ? swiperInstance.slides.length : 0;
    var slidesPerView = getCurrentSlidesPerView(swiperInstance);
    var maxIndex = Math.max(totalSlides - slidesPerView, 0);
    var currentIndex = Math.min(swiperInstance.activeIndex || 0, maxIndex);
    var progress = maxIndex === 0 ? 1 : (currentIndex / maxIndex);

    fillEl.style.width = (progress * 100) + '%';
  }

  var swiper = new Swiper(swiperEl, {
    slidesPerView: 1,
    spaceBetween: 20,
    watchOverflow: true,
    navigation: {
      nextEl: nextEl,
      prevEl: prevEl
    },
    breakpoints: {
      640: { slidesPerView: 1, spaceBetween: 20 },
      768: { slidesPerView: 2, spaceBetween: 24 },
      1024: { slidesPerView: 3, spaceBetween: 24 },
      1400: { slidesPerView: 4, spaceBetween: 24 }
    },
    on: {
      init: function() {
        updateProgress(this);
      },
      slideChange: function() {
        updateProgress(this);
      },
      resize: function() {
        updateProgress(this);
      },
      breakpoint: function() {
        updateProgress(this);
      }
    }
  });

  function openLightbox(videoUrl) {
    var videoId = getYouTubeVideoId(videoUrl);
    if (!videoId) return;

    var embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0&modestbranding=1';
    lightboxIframe.src = embedUrl;
    lightbox.classList.add('active');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeLightbox() {
    lightbox.classList.remove('active');
    lightbox.setAttribute('aria-hidden', 'true');
    lightboxIframe.src = '';
    document.body.style.overflow = '';
  }

  videoCards.forEach(function(card) {
    function triggerOpen(event) {
      if (event) event.preventDefault();
      var videoUrl = card.getAttribute('data-video-url');
      if (!videoUrl) return;
      openLightbox(videoUrl);
    }

    card.addEventListener('click', triggerOpen);

    card.addEventListener('keydown', function(e) {
      var key = e.key;
      if (key === 'Enter' || key === ' ') {
        e.preventDefault();
        triggerOpen(e);
      }
    });
  });

  closeBtn.addEventListener('click', closeLightbox);

  lightbox.addEventListener('click', function(e) {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });

  root.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && lightbox.classList.contains('active')) {
      closeLightbox();
    }
  });

  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:unload', function(event) {
      if (!event || !event.target) return;
      if (event.target.contains(root) || event.target === root) {
        if (swiper && typeof swiper.destroy === 'function') {
          swiper.destroy(true, true);
        }
        closeLightbox();
        window[sectionKey] = false;
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Rider Reviews 视频滑块",
  "tag": "section",
  "class": "rider-reviews-section",
  "settings": [
    { "type": "header", "content": "标题设置" },
    { "type": "text", "id": "section_title", "label": "模块标题", "default": "Rider Reviews" },
    { "type": "text", "id": "section_subtitle", "label": "模块副标题", "default": "See what our customers are saying" },

    { "type": "header", "content": "样式设置" },
    { "type": "color", "id": "progress_bar_color", "label": "底部进度条颜色", "default": "#F5D400" },
    { "type": "color", "id": "arrow_bg_color", "label": "导航按钮背景色", "default": "#111111" },
    { "type": "range", "id": "arrow_size", "label": "导航按钮尺寸", "min": 28, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "section_margin_top", "label": "Section 上边距", "min": 0, "max": 120, "step": 10, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "视频卡片",
      "settings": [
        { "type": "url", "id": "youtube_url", "label": "YouTube 视频链接", "info": "例如：https://www.youtube.com/watch?v=dQw4w9WgXcQ" },
        { "type": "image_picker", "id": "custom_thumbnail", "label": "自定义缩略图", "info": "留空则自动使用 YouTube 缩略图" },
        { "type": "text", "id": "video_title", "label": "视频标题", "default": "Aventon Ramblas Review: Is It Worth It?" },
        { "type": "text", "id": "view_count", "label": "播放量", "default": "27,562 views" },
        { "type": "text", "id": "reviewer_name", "label": "博主名称", "default": "Scott Hardesty" },
        { "type": "image_picker", "id": "reviewer_avatar", "label": "博主头像" },
        { "type": "image_picker", "id": "play_button", "label": "播放按钮 PNG", "info": "留空则使用默认播放按钮" }
      ]

{% assign section_id = 'features-slider-' | append: section.id %}

<section id="{{ section_id }}" class="hx-features-section">
  <div class="hx-features-container">
    {% assign section_heading = section.settings.heading | default: 'Features' %}
    {% if section_heading != blank %}
      <div class="hx-features-header">
        <h2 class="hx-features-title">{{ section_heading }}</h2>
      </div>
    {% endif %}

    <div class="hx-features-slider-wrapper">
      <div class="hx-features-track-outer">
        <div class="hx-features-track" data-track>
          {% for block in section.blocks %}
            <div class="hx-feature-card" {{ block.shopify_attributes }}>
              <div class="hx-feature-image-wrap">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      class: 'hx-feature-image',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 990px) 414px, 78vw'
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'hx-feature-image hx-feature-placeholder' }}
                {% endif %}
              </div>

              {% if block.settings.title != blank %}
                <h3 class="hx-feature-card-title">{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="hx-feature-card-text rte">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="hx-features-footer">
        <div class="hx-features-progress">
          <div class="hx-features-progress-thumb" data-progress></div>
        </div>

        <div class="hx-features-nav">
          <button type="button" class="hx-features-btn" data-prev aria-label="Previous">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M14.7 6.3a1 1 0 0 1 0 1.4L10.41 12l4.3 4.3a1 1 0 1 1-1.42 1.4l-5-5a1 1 0 0 1 0-1.4l5-5a1 1 0 0 1 1.42 0Z" fill="currentColor"/>
            </svg>
          </button>

          <button type="button" class="hx-features-btn" data-next aria-label="Next">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M9.3 17.7a1 1 0 0 1 0-1.4l4.29-4.3-4.3-4.3a1 1 0 0 1 1.42-1.4l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.42 0Z" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <style>
    #{{ section_id }} {
      --hx-card-width: 414px;
      background: {{ section.settings.bg_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      overflow: visible;
    }

    #{{ section_id }} .hx-features-container {
      max-width: {{ section.settings.page_width }}px;
      margin: 0 auto;
      padding: 0 32px;
      box-sizing: border-box;
    }

    #{{ section_id }} .hx-features-header {
      text-align: center;
      margin-bottom: 34px;
    }

    #{{ section_id }} .hx-features-title {
      margin: 0;
      color: {{ section.settings.heading_color }};
      font-size: clamp(30px, 4vw, 54px);
      line-height: 1.05;
      font-weight: 700;
      letter-spacing: -0.02em;
      display: block;
      position: relative;
      z-index: 1;
    }

    #{{ section_id }} .hx-features-slider-wrapper {
      position: relative;
    }

    #{{ section_id }} .hx-features-track-outer {
      overflow: hidden;
    }

    #{{ section_id }} .hx-features-track {
      display: flex;
      gap: {{ section.settings.desktop_gap }}px;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-behavior: auto;
      padding-bottom: 6px;
    }

    #{{ section_id }} .hx-features-track::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 990px) {
      #{{ section_id }} .hx-features-track.is-desktop {
        user-select: none;
        cursor: grab;
      }

      #{{ section_id }} .hx-features-track.is-desktop.is-dragging {
        cursor: grabbing;
      }
    }

    #{{ section_id }} .hx-feature-card {
      flex: 0 0 var(--hx-card-width);
      min-width: var(--hx-card-width);
      box-sizing: border-box;
    }

    #{{ section_id }} .hx-feature-image-wrap {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: {{ section.settings.image_radius }}px;
      overflow: hidden;
      background: #f3f3f3;
      margin-bottom: 18px;
    }

    #{{ section_id }} .hx-feature-image,
    #{{ section_id }} .hx-feature-placeholder {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      pointer-events: none;
      -webkit-user-drag: none;
      user-select: none;
    }

    #{{ section_id }} .hx-feature-card-title {
      margin: 0 0 12px;
      color: {{ section.settings.title_color }};
      font-size: 20px;
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    #{{ section_id }} .hx-feature-card-text {
      color: {{ section.settings.text_color }};
      font-size: 16px;
      line-height: 1.6;
    }

    #{{ section_id }} .hx-feature-card-text p {
      margin: 0;
    }

    #{{ section_id }} .hx-features-footer {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-top: 22px;
    }

    #{{ section_id }} .hx-features-progress {
      position: relative;
      flex: 1;
      height: 4px;
      background: rgba(0, 0, 0, 0.12);
      border-radius: 999px;
      overflow: hidden;
    }

    #{{ section_id }} .hx-features-progress-thumb {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 20%;
      min-width: 48px;
      background: {{ section.settings.progress_color }};
      border-radius: 999px;
      transform: translateX(0);
      transition: transform 0.12s linear, width 0.12s linear;
      will-change: transform, width;
    }

    #{{ section_id }} .hx-features-nav {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
    }

    #{{ section_id }} .hx-features-btn {
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #000;
      color: #fff;
      cursor: pointer;
      transition: opacity .2s ease, background-color .2s ease, color .2s ease;
    }

    #{{ section_id }} .hx-features-btn:hover:not([disabled]) {
      opacity: .92;
    }

    #{{ section_id }} .hx-features-btn[disabled] {
      background: #d9d9d9;
      color: #7a7a7a;
      cursor: not-allowed;
      opacity: 1;
    }

    @media screen and (max-width: 989px) {
      #{{ section_id }} .hx-features-container {
        padding: 16px 12px 0;
      }

      #{{ section_id }} .hx-features-header {
        margin-bottom: 22px;
        padding-top: 8px;
      }

      #{{ section_id }} .hx-features-title {
        font-size: 28px;
        line-height: 1.15;
      }

      #{{ section_id }} .hx-features-track-outer {
        overflow: visible;
      }

      #{{ section_id }} .hx-features-track {
        gap: {{ section.settings.mobile_gap }}px;
        cursor: auto;
        user-select: auto;
        -webkit-overflow-scrolling: touch;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        touch-action: pan-x;
        padding-bottom: 4px;
      }

      #{{ section_id }} .hx-feature-card {
        flex: 0 0 78%;
        min-width: 78%;
        scroll-snap-align: start;
      }

      #{{ section_id }} .hx-feature-image-wrap {
        margin-bottom: 14px;
      }

      #{{ section_id }} .hx-feature-card-title {
        font-size: 18px;
        margin-bottom: 10px;
      }

      #{{ section_id }} .hx-feature-card-text {
        font-size: 15px;
        line-height: 1.55;
      }

      #{{ section_id }} .hx-features-footer {
        margin-top: 18px;
      }

      #{{ section_id }} .hx-features-nav {
        display: none;
      }
    }
  </style>

  <script>
    (function() {
      const section = document.getElementById('{{ section_id }}');
      if (!section) return;

      if (section.dataset.hxInitialized === 'true') return;
      section.dataset.hxInitialized = 'true';

      const track = section.querySelector('[data-track]');
      const prevBtn = section.querySelector('[data-prev]');
      const nextBtn = section.querySelector('[data-next]');
      const progressThumb = section.querySelector('[data-progress]');

      if (!track) return;

      let animationId = null;
      let isDragging = false;
      let hasDragged = false;
      let dragStartX = 0;
      let dragStartScrollLeft = 0;
      let desktopDragBound = false;
      let resizeTimer = null;

      function getCards() {
        return Array.from(track.querySelectorAll('.hx-feature-card'));
      }

      function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
      }

      function easeInOutCubic(t) {
        return t < 0.5
          ? 4 * t * t * t
          : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }

      function getCardStep() {
        const cards = getCards();
        if (!cards.length) return track.clientWidth;

        if (cards.length < 2) {
          return cards[0].offsetWidth;
        }

        return cards[1].offsetLeft - cards[0].offsetLeft;
      }

      function getMaxScroll() {
        return Math.max(track.scrollWidth - track.clientWidth, 0);
      }

      function stopAnimation() {
        if (animationId) {
          cancelAnimationFrame(animationId);
          animationId = null;
        }
      }

      function updateButtons() {
        const maxScroll = getMaxScroll();
        const canScroll = maxScroll > 2;

        if (prevBtn) {
          prevBtn.disabled = !canScroll || track.scrollLeft <= 2;
        }

        if (nextBtn) {
          nextBtn.disabled = !canScroll || track.scrollLeft >= maxScroll - 2;
        }
      }

      function updateProgress() {
        if (!progressThumb) return;

        const maxScroll = getMaxScroll();
        const trackWidth = progressThumb.parentElement ? progressThumb.parentElement.clientWidth : 0;

        if (maxScroll <= 0 || track.scrollWidth <= 0 || trackWidth <= 0) {
          progressThumb.style.width = '100%';
          progressThumb.style.transform = 'translateX(0px)';
          return;
        }

        const visibleRatio = clamp(track.clientWidth / track.scrollWidth, 0.12, 1);
        const thumbWidth = Math.max(trackWidth * visibleRatio, 48);
        const maxTranslate = Math.max(trackWidth - thumbWidth, 0);
        const scrollRatio = clamp(track.scrollLeft / maxScroll, 0, 1);
        const translateX = maxTranslate * scrollRatio;

        progressThumb.style.width = thumbWidth + 'px';
        progressThumb.style.transform = 'translateX(' + translateX + 'px)';
      }

      function updateUI() {
        updateButtons();
        updateProgress();
      }

      function animateTo(target) {
        stopAnimation();

        const start = track.scrollLeft;
        const end = clamp(target, 0, getMaxScroll());
        const distance = end - start;

        if (Math.abs(distance) < 1) {
          track.scrollLeft = end;
          updateUI();
          return;
        }

        const duration = 450;
        const startTime = performance.now();

        function frame(now) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = easeInOutCubic(progress);

          track.scrollLeft = start + distance * eased;
          updateUI();

          if (progress < 1) {
            animationId = requestAnimationFrame(frame);
          } else {
            animationId = null;
            track.scrollLeft = end;
            updateUI();
          }
        }

        animationId = requestAnimationFrame(frame);
      }

      function slideBy(direction) {
        const step = getCardStep();
        animateTo(track.scrollLeft + step * direction);
      }

      function isDesktop() {
        return window.innerWidth >= 990;
      }

      function handlePrevClick() {
        slideBy(-1);
      }

      function handleNextClick() {
        slideBy(1);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', handlePrevClick);
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', handleNextClick);
      }

      function onMouseDown(e) {
        if (!isDesktop()) return;
        if (e.button !== 0) return;

        stopAnimation();
        isDragging = true;
        hasDragged = false;
        dragStartX = e.clientX;
        dragStartScrollLeft = track.scrollLeft;
        track.classList.add('is-dragging');
        e.preventDefault();
      }

      function onMouseMove(e) {
        if (!isDragging) return;

        const delta = e.clientX - dragStartX;
        if (Math.abs(delta) > 5) {
          hasDragged = true;
        }

        track.scrollLeft = dragStartScrollLeft - delta;
        updateUI();
      }

      function endDrag() {
        if (!isDragging) return;
        isDragging = false;
        track.classList.remove('is-dragging');
        updateUI();
      }

      function suppressClickAfterDrag(e) {
        if (!hasDragged) return;
        e.preventDefault();
        e.stopPropagation();
        hasDragged = false;
      }

      function bindDesktopDrag() {
        if (desktopDragBound) return;
        desktopDragBound = true;

        track.addEventListener('mousedown', onMouseDown);
        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', endDrag);
        window.addEventListener('blur', endDrag);

        track.classList.add('is-desktop');
      }

      function unbindDesktopDrag() {
        if (!desktopDragBound) return;
        desktopDragBound = false;

        track.removeEventListener('mousedown', onMouseDown);
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseup', endDrag);
        window.removeEventListener('blur', endDrag);

        track.classList.remove('is-desktop');
        track.classList.remove('is-dragging');
        isDragging = false;
        hasDragged = false;
      }

      function applyMode() {
        if (isDesktop()) {
          bindDesktopDrag();
        } else {
          unbindDesktopDrag();
        }
        updateUI();
      }

      track.addEventListener('scroll', updateUI, { passive: true });
      track.addEventListener('click', suppressClickAfterDrag, true);

      track.querySelectorAll('img, a').forEach(function(el) {
        el.addEventListener('dragstart', function(e) {
          e.preventDefault();
        });
      });

      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
          applyMode();
        }, 80);
      });

      window.addEventListener('load', function() {
        updateUI();
      });

      document.addEventListener('shopify:section:load', function(event) {
        if (!event.target || !event.target.contains(section)) return;
        applyMode();
      });

      document.addEventListener('shopify:section:reorder', function() {
        applyMode();
      });

      applyMode();

      setTimeout(function() {
        updateUI();
      }, 120);

      setTimeout(function() {
        updateUI();
      }, 400);
    })();
  </script>
</section>

{% schema %}
{
  "name": "HX Features slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Features"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Page width",
      "min": 1200,
      "max": 1900,
      "step": 20,
      "default": 1760
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 12,
      "max": 40,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 8,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1f2937"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text color",
      "default": "#5c5c5c"
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Progress bar color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Add feature description here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "HX Features slider",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
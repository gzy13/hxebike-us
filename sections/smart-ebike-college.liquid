{% liquid
  assign has_content = false
  assign has_media = false

  if section.settings.heading != blank
    assign has_content = true
  elsif section.settings.subheading != blank
    assign has_content = true
  elsif section.settings.description != blank
    assign has_content = true
  elsif section.settings.feature_1 != blank
    assign has_content = true
  elsif section.settings.feature_2 != blank
    assign has_content = true
  elsif section.settings.feature_3 != blank
    assign has_content = true
  elsif section.settings.feature_4 != blank
    assign has_content = true
  endif

  if section.settings.image_1 != blank
    assign has_media = true
  elsif section.settings.image_2 != blank
    assign has_media = true
  elsif section.settings.image_3 != blank
    assign has_media = true
  elsif section.settings.image_4 != blank
    assign has_media = true
  endif
%}

<section
  id="smart-ebike-collage-{{ section.id }}"
  class="smart-ebike-collage section-{{ section.id }}"
  aria-label="{{ section.settings.heading | default: 'Smart Ebike collage' | escape }}"
  style="
    --sec-pt: {{ section.settings.padding_top }}px;
    --sec-pb: {{ section.settings.padding_bottom }}px;
    --sec-bg: {{ section.settings.bg_color }};
    --sec-heading: {{ section.settings.heading_color }};
    --sec-subheading: {{ section.settings.subheading_color }};
    --sec-text: {{ section.settings.text_color }};

    --heading-size: {{ section.settings.heading_size }}px;
    --subheading-size: {{ section.settings.subheading_size }}px;
    --description-size: {{ section.settings.description_size }}px;
    --feature-size: {{ section.settings.feature_size }}px;

    --heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --description-size-mobile: {{ section.settings.description_size_mobile }}px;
    --feature-size-mobile: {{ section.settings.feature_size_mobile }}px;

    --content-max-width: {{ section.settings.content_max_width }}px;
    --grid-gap: {{ section.settings.grid_gap }}px;
    --media-gap: {{ section.settings.media_gap }}px;
    --card-radius: {{ section.settings.card_radius }}px;
    --card-radius-mobile: {{ section.settings.card_radius_mobile }}px;
  "
>
  <div class="smart-ebike-collage__inner page-width{% if has_content == false %} smart-ebike-collage__inner--media-only{% endif %}{% if has_media == false %} smart-ebike-collage__inner--content-only{% endif %}">
    {% if has_content %}
      <div class="smart-ebike-collage__content">
        {% if section.settings.heading != blank %}
          <h2 class="smart-ebike-collage__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="smart-ebike-collage__subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="smart-ebike-collage__description rte">
            {{ section.settings.description | newline_to_br }}
          </div>
        {% endif %}

        {% assign has_features = false %}
        {% if section.settings.feature_1 != blank or section.settings.feature_2 != blank or section.settings.feature_3 != blank or section.settings.feature_4 != blank %}
          {% assign has_features = true %}
        {% endif %}

        {% if has_features %}
          <ul class="smart-ebike-collage__features" role="list">
            {% if section.settings.feature_1 != blank %}
              <li class="smart-ebike-collage__feature-item">{{ section.settings.feature_1 }}</li>
            {% endif %}
            {% if section.settings.feature_2 != blank %}
              <li class="smart-ebike-collage__feature-item">{{ section.settings.feature_2 }}</li>
            {% endif %}
            {% if section.settings.feature_3 != blank %}
              <li class="smart-ebike-collage__feature-item">{{ section.settings.feature_3 }}</li>
            {% endif %}
            {% if section.settings.feature_4 != blank %}
              <li class="smart-ebike-collage__feature-item">{{ section.settings.feature_4 }}</li>
            {% endif %}
          </ul>
        {% endif %}
      </div>
    {% endif %}

    {% if has_media %}
      <div class="smart-ebike-collage__media-wrap">
        <div class="smart-ebike-collage__media">
          {% if section.settings.image_1 != blank %}
            <div class="smart-ebike-collage__card smart-ebike-collage__card--1">
              {{
                section.settings.image_1
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 18vw, 24vw',
                  class: 'smart-ebike-collage__image',
                  alt: section.settings.image_1.alt | escape
              }}
            </div>
          {% endif %}

          {% if section.settings.image_2 != blank %}
            <div class="smart-ebike-collage__card smart-ebike-collage__card--2">
              {{
                section.settings.image_2
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 18vw, 24vw',
                  class: 'smart-ebike-collage__image',
                  alt: section.settings.image_2.alt | escape
              }}
            </div>
          {% endif %}

          {% if section.settings.image_3 != blank %}
            <div class="smart-ebike-collage__card smart-ebike-collage__card--3">
              {{
                section.settings.image_3
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 18vw, 24vw',
                  class: 'smart-ebike-collage__image',
                  alt: section.settings.image_3.alt | escape
              }}
            </div>
          {% endif %}

          {% if section.settings.image_4 != blank %}
            <div class="smart-ebike-collage__card smart-ebike-collage__card--4">
              {{
                section.settings.image_4
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 640, 900',
                  sizes: '(min-width: 990px) 18vw, 24vw',
                  class: 'smart-ebike-collage__image',
                  alt: section.settings.image_4.alt | escape
              }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background: var(--sec-bg);
    padding-top: var(--sec-pt);
    padding-bottom: var(--sec-pb);
  }

  .section-{{ section.id }} .smart-ebike-collage__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--grid-gap);
    align-items: center;
  }

  .section-{{ section.id }} .smart-ebike-collage__inner--content-only {
    grid-template-columns: 1fr;
  }

  .section-{{ section.id }} .smart-ebike-collage__inner--media-only {
    grid-template-columns: 1fr;
  }

  .section-{{ section.id }} .smart-ebike-collage__content {
    max-width: var(--content-max-width);
  }

  .section-{{ section.id }} .smart-ebike-collage__media-wrap {
    width: 100%;
    min-width: 0;
  }

  .section-{{ section.id }} .smart-ebike-collage__heading {
    margin: 0 0 10px;
    color: var(--sec-heading);
    font-size: var(--heading-size);
    line-height: 1.05;
    font-weight: 800;
    word-break: break-word;
  }

  .section-{{ section.id }} .smart-ebike-collage__subheading {
    margin: 0 0 28px;
    color: var(--sec-subheading);
    font-size: var(--subheading-size);
    line-height: 1.2;
    font-weight: 500;
    word-break: break-word;
  }

  .section-{{ section.id }} .smart-ebike-collage__description {
    margin: 0 0 24px;
    color: var(--sec-text);
    font-size: var(--description-size);
    line-height: 1.6;
  }

  .section-{{ section.id }} .smart-ebike-collage__description p:last-child {
    margin-bottom: 0;
  }

  .section-{{ section.id }} .smart-ebike-collage__features {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section-{{ section.id }} .smart-ebike-collage__feature-item {
    position: relative;
    margin: 0 0 12px;
    padding-left: 22px;
    color: var(--sec-text);
    font-size: var(--feature-size);
    line-height: 1.5;
  }

  .section-{{ section.id }} .smart-ebike-collage__feature-item:last-child {
    margin-bottom: 0;
  }

  .section-{{ section.id }} .smart-ebike-collage__feature-item::before {
    content: "◎";
    position: absolute;
    left: 0;
    top: 0;
    line-height: 1.5;
  }

  .section-{{ section.id }} .smart-ebike-collage__media {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--media-gap);
    align-items: start;
  }

  .section-{{ section.id }} .smart-ebike-collage__card {
    overflow: hidden;
    border-radius: var(--card-radius);
    background: rgba(0, 0, 0, 0.06);
    min-width: 0;
  }

  .section-{{ section.id }} .smart-ebike-collage__card--1 {
    margin-top: 44px;
    aspect-ratio: 0.62 / 1.25;
  }

  .section-{{ section.id }} .smart-ebike-collage__card--2 {
    margin-top: 86px;
    aspect-ratio: 0.62 / 1.9;
  }

  .section-{{ section.id }} .smart-ebike-collage__card--3 {
    margin-top: 0;
    aspect-ratio: 0.62 / 1.95;
  }

  .section-{{ section.id }} .smart-ebike-collage__card--4 {
    margin-top: 108px;
    aspect-ratio: 0.62 / 1.35;
  }

  .section-{{ section.id }} .smart-ebike-collage__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    .section-{{ section.id }} .smart-ebike-collage__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .section-{{ section.id }} .smart-ebike-collage__content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .smart-ebike-collage__inner {
      display: block;
    }

    .section-{{ section.id }} .smart-ebike-collage__content {
      max-width: 100%;
      margin-bottom: 30px;
    }

    .section-{{ section.id }} .smart-ebike-collage__heading {
      font-size: var(--heading-size-mobile);
      line-height: 1.08;
      margin-bottom: 10px;
    }

    .section-{{ section.id }} .smart-ebike-collage__subheading {
      font-size: var(--subheading-size-mobile);
      line-height: 1.25;
      margin-bottom: 18px;
    }

    .section-{{ section.id }} .smart-ebike-collage__description {
      margin-bottom: 18px;
      font-size: var(--description-size-mobile);
      line-height: 1.7;
    }

    .section-{{ section.id }} .smart-ebike-collage__feature-item {
      margin-bottom: 8px;
      padding-left: 18px;
      font-size: var(--feature-size-mobile);
      line-height: 1.45;
    }

    .section-{{ section.id }} .smart-ebike-collage__media-wrap {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      padding-left: 12px;
      padding-right: 12px;
      box-sizing: border-box;
      overflow: hidden;
    }

    .section-{{ section.id }} .smart-ebike-collage__media {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      align-items: start;
    }

    .section-{{ section.id }} .smart-ebike-collage__card {
      border-radius: var(--card-radius-mobile);
    }

    .section-{{ section.id }} .smart-ebike-collage__card--1 {
      margin-top: 34px;
      aspect-ratio: 0.62 / 1.25;
    }

    .section-{{ section.id }} .smart-ebike-collage__card--2 {
      margin-top: 72px;
      aspect-ratio: 0.62 / 1.9;
    }

    .section-{{ section.id }} .smart-ebike-collage__card--3 {
      margin-top: 0;
      aspect-ratio: 0.62 / 1.95;
    }

    .section-{{ section.id }} .smart-ebike-collage__card--4 {
      margin-top: 88px;
      aspect-ratio: 0.62 / 1.35;
    }
  }
</style>

{% schema %}
{
  "name": "Smart Ebike Collage",
  "tag": "section",
  "class": "section-smart-ebike-collage",
  "settings": [
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Smart Ebike"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题",
      "default": "Multiple scenarios to ride"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "描述",
      "default": "hxebike smart electric bicycles are designed to elevate your riding experience with advanced technology, powerful performance, and all-terrain capability."
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "卖点 1",
      "default": "GPS Tracking & Anti-Theft"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "卖点 2",
      "default": "All Terrain & 90 Miles Range"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "卖点 3",
      "default": "Torque Sensor & Shimano 7-Speed"
    },
    {
      "type": "text",
      "id": "feature_4",
      "label": "卖点 4",
      "default": "Hydraulic Brakes & Smart Display"
    },

    {
      "type": "header",
      "content": "图片设置"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "图片 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "图片 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "图片 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "图片 4"
    },

    {
      "type": "header",
      "content": "桌面端字体"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题字号",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "副标题字号",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "描述字号",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "feature_size",
      "label": "卖点字号",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },

    {
      "type": "header",
      "content": "移动端字体"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "移动端标题字号",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "移动端副标题字号",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "移动端描述字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "feature_size_mobile",
      "label": "移动端卖点字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "布局设置"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "内容区最大宽度",
      "min": 360,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "左右区域间距",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "media_gap",
      "label": "图片间距",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "桌面端图片圆角",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius_mobile",
      "label": "移动端图片圆角",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "header",
      "content": "颜色设置"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "副标题颜色",
      "default": "#e25b2c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "正文颜色",
      "default": "#111111"
    },

    {
      "type": "header",
      "content": "区块间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Smart Ebike Collage"
    }
  ]
}
{% endschema %}
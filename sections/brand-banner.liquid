{%- liquid
  assign desktop_image = section.settings.image_desktop | default: section.settings.image_mobile
  assign mobile_image = section.settings.image_mobile | default: desktop_image
  assign image_alt = section.settings.image_alt | default: section.settings.heading | strip_html | escape
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign loading = 'lazy'
  assign fetchpriority = 'auto'

  if section.index == 1
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
-%}

<section
  id="BrandBanner-{{ section.id }}"
  class="brand-banner{% if section.settings.full_width %} brand-banner--full{% endif %}"
  style="
    --brand-banner-text: {{ section.settings.text_color }};
    --brand-banner-muted: {{ section.settings.muted_color }};
    --brand-banner-overlay: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_opacity }};
    --brand-banner-desktop-object-position: {{ section.settings.desktop_image_position }};
    --brand-banner-mobile-object-position: {{ section.settings.mobile_image_position }};
    --brand-banner-desktop-height: {{ section.settings.desktop_height }}px;
    --brand-banner-mobile-height: {{ section.settings.mobile_height }}px;
    --brand-banner-eyebrow-size-desktop: {{ section.settings.eyebrow_size_desktop }}px;
    --brand-banner-eyebrow-size-mobile: {{ section.settings.eyebrow_size_mobile }}px;
    --brand-banner-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --brand-banner-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --brand-banner-text-size-desktop: {{ section.settings.text_size_desktop }}px;
    --brand-banner-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --brand-banner-padding-top: {{ section.settings.padding_top }}px;
    --brand-banner-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="brand-banner__frame">
    <div class="brand-banner__media" aria-hidden="{% if image_alt == blank %}true{% else %}false{% endif %}">
      {%- if desktop_image != blank -%}
        <picture>
          {%- if mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 375 }} 375w,
                {{ mobile_image | image_url: width: 550 }} 550w,
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 900 }} 900w,
                {{ mobile_image | image_url: width: 1100 }} 1100w,
                {{ mobile_image | image_url: width: 1400 }} 1400w
              "
              sizes="100vw"
              width="{{ mobile_image.width }}"
              height="{{ mobile_image.height }}"
            >
          {%- endif -%}
          {{
            desktop_image
            | image_url: width: 2400
            | image_tag:
              loading: loading,
              fetchpriority: fetchpriority,
              widths: '750, 1000, 1250, 1500, 1750, 2000, 2400, 2800, 3200',
              sizes: '100vw',
              alt: image_alt,
              class: 'brand-banner__image'
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'brand-banner__placeholder' }}
      {%- endif -%}
    </div>

    <span class="brand-banner__overlay" aria-hidden="true"></span>

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="brand-banner__content brand-banner__content--{{ section.settings.content_position }} brand-banner__content--mobile-{{ section.settings.mobile_content_position }}">
        <div class="brand-banner__text-box">
          {%- if section.settings.eyebrow != blank -%}
            <p class="brand-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="brand-banner__heading">
              {{ section.settings.heading }}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="brand-banner__text rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #BrandBanner-{{ section.id }} {
    color: var(--brand-banner-text);
    display: block;
    padding-top: var(--brand-banner-padding-top);
    padding-bottom: var(--brand-banner-padding-bottom);
    width: 100%;
  }

  #BrandBanner-{{ section.id }} * {
    box-sizing: border-box;
  }

  #BrandBanner-{{ section.id }}.brand-banner--full {
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  #BrandBanner-{{ section.id }} .brand-banner__frame {
    aspect-ratio: 16 / 9;
    background: #111;
    height: var(--brand-banner-desktop-height);
    min-height: 240px;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  #BrandBanner-{{ section.id }} .brand-banner__media,
  #BrandBanner-{{ section.id }} .brand-banner__media picture,
  #BrandBanner-{{ section.id }} .brand-banner__image,
  #BrandBanner-{{ section.id }} .brand-banner__placeholder {
    display: block;
    height: 100%;
    width: 100%;
  }

  #BrandBanner-{{ section.id }} .brand-banner__image,
  #BrandBanner-{{ section.id }} .brand-banner__placeholder {
    object-fit: cover;
    object-position: var(--brand-banner-desktop-object-position);
  }

  #BrandBanner-{{ section.id }} .brand-banner__placeholder {
    background: #f4f1ec;
  }

  #BrandBanner-{{ section.id }} .brand-banner__overlay {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.46) 0%, rgba(0, 0, 0, 0.18) 42%, rgba(0, 0, 0, 0.04) 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.38) 0%, rgba(0, 0, 0, 0) 48%),
      var(--brand-banner-overlay);
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  #BrandBanner-{{ section.id }} .brand-banner__content {
    display: flex;
    inset: 0;
    padding: clamp(28px, 5vw, 76px);
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }

  #BrandBanner-{{ section.id }} .brand-banner__content--bottom-left {
    align-items: flex-end;
    justify-content: flex-start;
  }

  #BrandBanner-{{ section.id }} .brand-banner__content--center-left {
    align-items: center;
    justify-content: flex-start;
  }

  #BrandBanner-{{ section.id }} .brand-banner__content--bottom-center {
    align-items: flex-end;
    justify-content: center;
    text-align: center;
  }

  #BrandBanner-{{ section.id }} .brand-banner__content--center {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  #BrandBanner-{{ section.id }} .brand-banner__content--bottom-right {
    align-items: flex-end;
    justify-content: flex-end;
    text-align: right;
  }

  #BrandBanner-{{ section.id }} .brand-banner__text-box {
    max-width: min(620px, 92vw);
    pointer-events: auto;
    text-shadow: 0 18px 44px rgba(0, 0, 0, 0.28);
  }

  #BrandBanner-{{ section.id }} .brand-banner__eyebrow {
    color: var(--brand-banner-muted);
    font-size: var(--brand-banner-eyebrow-size-desktop);
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  #BrandBanner-{{ section.id }} .brand-banner__heading {
    color: var(--brand-banner-text);
    font-size: var(--brand-banner-heading-size-desktop);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.98;
    margin: 0;
    max-width: 11em;
  }

  #BrandBanner-{{ section.id }} .brand-banner__text {
    color: var(--brand-banner-muted);
    font-size: var(--brand-banner-text-size-desktop);
    line-height: 1.65;
    margin-top: 18px;
    max-width: 34em;
  }

  #BrandBanner-{{ section.id }} .brand-banner__text p {
    margin-bottom: 0;
    margin-top: 0;
  }

  @media screen and (max-width: 749px) {
    #BrandBanner-{{ section.id }} .brand-banner__frame {
      aspect-ratio: 3 / 4;
      height: var(--brand-banner-mobile-height);
      min-height: 0;
    }

    #BrandBanner-{{ section.id }} .brand-banner__image,
    #BrandBanner-{{ section.id }} .brand-banner__placeholder {
      object-position: var(--brand-banner-mobile-object-position);
    }

    #BrandBanner-{{ section.id }} .brand-banner__overlay {
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.58) 0%, rgba(0, 0, 0, 0.18) 52%, rgba(0, 0, 0, 0.02) 100%),
        var(--brand-banner-overlay);
    }

    #BrandBanner-{{ section.id }} .brand-banner__content {
      padding: 28px 22px;
    }

    #BrandBanner-{{ section.id }} .brand-banner__content--mobile-bottom {
      align-items: flex-end;
      justify-content: center;
      text-align: center;
    }

    #BrandBanner-{{ section.id }} .brand-banner__content--mobile-center {
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    #BrandBanner-{{ section.id }} .brand-banner__content--mobile-top {
      align-items: flex-start;
      justify-content: center;
      text-align: center;
    }

    #BrandBanner-{{ section.id }} .brand-banner__text-box {
      max-width: 100%;
    }

    #BrandBanner-{{ section.id }} .brand-banner__eyebrow {
      font-size: var(--brand-banner-eyebrow-size-mobile);
      margin-bottom: 10px;
    }

    #BrandBanner-{{ section.id }} .brand-banner__heading {
      font-size: var(--brand-banner-heading-size-mobile);
      max-width: 100%;
    }

    #BrandBanner-{{ section.id }} .brand-banner__text {
      font-size: var(--brand-banner-text-size-mobile);
      line-height: 1.55;
      margin-top: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Premium banner",
  "tag": "section",
  "class": "section-premium-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop banner image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile banner image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "header",
      "content": "Banner height"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 360,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 360,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New arrival"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for the everyday escape"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A refined banner built around strong imagery, quiet typography, and a cinematic crop on every screen.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "div", "label": "Div" }
      ]
    },
    {
      "type": "header",
      "content": "Font sizes"
    },
    {
      "type": "range",
      "id": "eyebrow_size_desktop",
      "label": "Eyebrow size desktop",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "label": "Eyebrow size mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size desktop",
      "min": 28,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size mobile",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Text size desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size mobile",
      "min": 12,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Desktop text position",
      "default": "bottom-left",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "center-left", "label": "Center left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Mobile text position",
      "default": "bottom",
      "options": [
        { "value": "bottom", "label": "Bottom" },
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" }
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Subtext color",
      "default": "#f1eee8"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Premium banner"
    }
  ]
}
{% endschema %}

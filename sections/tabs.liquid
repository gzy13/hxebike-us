{%- liquid
  assign yt_url = section.settings.youtube_url | default: 'https://www.youtube.com/watch?v=z56akSPBqJQ'
  assign yt_id = yt_url | split: 'v=' | last | split: '&' | first
  if yt_url contains 'youtu.be/'
    assign yt_id = yt_url | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first
  endif
  if yt_url contains '/embed/'
    assign yt_id = yt_url | split: '/embed/' | last | split: '?' | first | split: '&' | first
  endif

  assign geo_rows = "Frame Size|Standard||Wheel Size|27.5&quot; &times; 2.25&quot;||Seat Tube Length|12.6&quot; / 32 cm||Top Tube Length (Horizontal)|7.9&quot; / 20 cm||Bottom Bracket Drop|1.6&quot; / 4 cm||Head Tube Length|4.3&quot; / 11 cm||Head Tube Angle|71&deg;||Seat Tube Angle|73&deg;||Rear Chainstay Length|6.9&quot; / 17.5 cm||Front Wheel Center|10.6&quot; / 27 cm||Wheelbase|48.8&quot; / 124 cm||Reach|18.1&quot; / 46 cm||Stack Height|8.5&quot; / 21.5 cm||Fork Length|7.5&quot; / 19 cm||Fork Offset|1.6&quot; / 4 cm||Trail|3.1&quot; / 7.97 cm||Standover Height|28.7&quot; / 73 cm||Rider Height|5'5&quot; ~ 6'5&quot; (165 ~ 190 cm)" | split: "||"
  assign tech_left = "Spokes|12-Gauge Stainless Steel||Seat Post|33.9mm Adjustable Aluminum Seat Tube||Rims|27.5&quot; Aluminum Alloy Rims||Handlebar|Aluminum Alloy, 24.4&quot; / 620mm, &Oslash;31.8mm||Gearing|Shimano SL-TX50-7R, 7-Speed Shifter||Frame|6061 Aluminum Alloy||Derailleur|7-Speed Shimano Rear Derailleur||Crank Set|170mm Forged Aluminum Crank, 38T||Display|3.7&quot; LCD Color Smart Display" | split: "||"
  assign tech_right = "Sensor|85N.m Hall Sensor, 4-Level Pedal Assist||Saddle|Velo Ergonomic Sport Saddle||Kickstand|6061 Aluminum Alloy Kickstand||Throttle|Twist Throttle||Max Hill Climbing Angle|30&deg;||Front Fork|100mm travel with lockout||Chain|KMC Z9 Stainless Steel Chain||Brakes|180mm Hydraulic Disc Brakes||Tires|CST 27.5&quot; &times; 2.25&quot; Mountain Tires" | split: "||"
  assign warranty_rows = "Parts|2 years||Battery|2 years||Frame|2 years" | split: "||"
-%}

<section
  id="tabs-{{ section.id }}"
  class="hxTabs"
  style="
    --tabs-padding-top:{{ section.settings.padding_top }}px;
    --tabs-padding-bottom:{{ section.settings.padding_bottom }}px;
  "
>
  <div class="hxTabs__header">
    <h2 class="hxTabs__title">{{ section.settings.title | escape }}</h2>
    <div class="hxTabs__navWrap">
      <div class="hxTabs__nav" role="tablist" aria-label="{{ section.settings.title | escape }}">
        {%- assign tabs = "fit|Size & Fit||geo|Geometry||tech|Technical||war|Warranty & Note||asm|Assembly Video" | split: "||" -%}
        {%- for item in tabs -%}
          {%- assign t = item | split: "|" -%}
          <button
            class="hxTabs__tab{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="tab"
            id="tab-{{ section.id }}-{{ t[0] }}"
            aria-controls="panel-{{ section.id }}-{{ t[0] }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-tab="{{ t[0] }}"
          >{{ t[1] }}</button>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="hxTabs__panels">
    <div class="hxTabs__panel is-active" id="panel-{{ section.id }}-fit" role="tabpanel" aria-labelledby="tab-{{ section.id }}-fit" data-panel="fit">
      <div class="sf" data-sf style="--accent:{{ section.settings.accent }};--max:{{ section.settings.max_width }}px;">
        <div class="sf__grid">
          <div class="sf__slider" data-sf-slider>
            <div class="sf__fitBand" aria-hidden="true"></div>
            <div class="sf__knob" data-sf-knob><span data-sf-knob-text>6'0"</span></div>
            <button class="sf__hit" type="button" data-sf-hit aria-label="Drag to select height"></button>
          </div>

          <div class="sf__copy">
            <div class="sf__height"><span data-sf-display>6'0"</span><b>Height</b></div>
            <p class="sf__sub">Move the slider to match your height</p>
            <div class="sf__rule"></div>
            <div class="sf__result">
              <span class="sf__icon" aria-hidden="true"></span>
              <div>
                <p class="sf__desc" data-sf-desc>{{ section.settings.ok_text }}</p>
                <p class="sf__hint">Recommended height: 5'5" - 6'5"</p>
              </div>
            </div>
          </div>

          <div class="sf__image">
            {% if section.settings.silhouette != blank %}
              <img class="sf__sil" src="{{ section.settings.silhouette | image_url: width: 1400 }}" alt="Silhouette" loading="lazy">
            {% endif %}
            {% if section.settings.bike_image != blank %}
              <img class="sf__bike" src="{{ section.settings.bike_image | image_url: width: 2200 }}" alt="Bike" loading="lazy">
            {% elsif product.featured_image != blank %}
              <img class="sf__bike" src="{{ product.featured_image | image_url: width: 2200 }}" alt="{{ product.title | escape }}" loading="lazy">
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="hxTabs__panel" id="panel-{{ section.id }}-geo" role="tabpanel" aria-labelledby="tab-{{ section.id }}-geo" data-panel="geo" hidden>
      <div class="hxPanel hxGeo">
        <div class="hxPanel__grid hxPanel__grid--geo">
          <div class="hxPanel__table" role="table" aria-label="Geometry parameters">
            {%- for row in geo_rows -%}
              {%- assign c = row | split: "|" -%}
              <div class="hxPanel__row" role="row"><div role="cell">{{ c[0] }}</div><div role="cell">{{ c[1] }}</div></div>
            {%- endfor -%}
          </div>
          <div class="hxGeo__images">
            <img src="{{ section.settings.geometry_image_url }}" alt="Geometry diagram" loading="lazy">
            {%- if section.settings.box_image_url != blank -%}
              <img src="{{ section.settings.box_image_url }}" alt="HX-Q5 outer box" loading="lazy">
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    <div class="hxTabs__panel" id="panel-{{ section.id }}-tech" role="tabpanel" aria-labelledby="tab-{{ section.id }}-tech" data-panel="tech" hidden>
      <div class="hxPanel">
        <div class="hxPanel__grid">
          {%- for group in (1..2) -%}
            <div class="hxPanel__table" role="table" aria-label="Technical parameters">
              {%- assign rows = tech_left -%}
              {%- if group == 2 -%}{%- assign rows = tech_right -%}{%- endif -%}
              {%- for row in rows -%}
                {%- assign c = row | split: "|" -%}
                <div class="hxPanel__row" role="row"><div role="cell">{{ c[0] }}</div><div role="cell">{{ c[1] }}</div></div>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="hxTabs__panel" id="panel-{{ section.id }}-war" role="tabpanel" aria-labelledby="tab-{{ section.id }}-war" data-panel="war" hidden>
      <div class="hxPanel">
        <div class="hxPanel__grid">
          <div class="hxPanel__table">
            <div class="hxPanel__row hxPanel__row--stack">
              <div>Terms &amp; Conditions</div>
              <div>Warranty applies only to the original HX owner and covers replacement of faulty components.<br><br>Replacement costs are covered by HX, while the buyer is responsible for shipping fees.</div>
            </div>
          </div>
          <div class="hxPanel__table" role="table" aria-label="Warranty terms">
            {%- for row in warranty_rows -%}
              {%- assign c = row | split: "|" -%}
              <div class="hxPanel__row" role="row"><div role="cell">{{ c[0] }}</div><div role="cell">{{ c[1] }}</div></div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>

    <div class="hxTabs__panel" id="panel-{{ section.id }}-asm" role="tabpanel" aria-labelledby="tab-{{ section.id }}-asm" data-panel="asm" hidden>
      <div class="hxAssembly">
        <div class="hxAssembly__ratio">
          <iframe
            src="https://www.youtube.com/embed/{{ yt_id }}?rel=0&modestbranding=1"
            title="Assembly Video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <style>
    #tabs-{{ section.id }}{padding:var(--tabs-padding-top) 0 var(--tabs-padding-bottom);color:#111;font-family:var(--font-body-family,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif)}
    #tabs-{{ section.id }} *{box-sizing:border-box}
    #tabs-{{ section.id }} .hxTabs__header{max-width:1680px;margin:auto;padding:0 clamp(16px,3vw,64px)}
    #tabs-{{ section.id }} .hxTabs__title{margin:0 0 18px;text-align:center;font-size:clamp(28px,3.6vw,52px);font-weight:500;line-height:1.1}
    #tabs-{{ section.id }} .hxTabs__navWrap{border-bottom:1px solid rgba(0,0,0,.35);overflow:auto;scrollbar-width:none}
    #tabs-{{ section.id }} .hxTabs__navWrap::-webkit-scrollbar{display:none}
    #tabs-{{ section.id }} .hxTabs__nav{display:flex;justify-content:center;gap:28px;width:max-content;min-width:100%;padding:0 0 10px}
    #tabs-{{ section.id }} .hxTabs__tab{border:0;background:transparent;color:#111;font-size:16px;font-weight:500;line-height:1;padding:14px 22px;white-space:nowrap;cursor:pointer}
    #tabs-{{ section.id }} .hxTabs__tab.is-active{background:#111;color:#fff}
    #tabs-{{ section.id }} .hxTabs__panels{margin-top:8px}

    #tabs-{{ section.id }} .hxPanel{padding:40px 0}
    #tabs-{{ section.id }} .hxPanel__grid{max-width:1680px;margin:auto;padding:0 clamp(16px,3vw,64px);display:grid;grid-template-columns:1fr 1fr;gap:clamp(18px,3vw,56px);align-items:start}
    #tabs-{{ section.id }} .hxPanel__grid--geo{grid-template-columns:1fr 1.1fr}
    #tabs-{{ section.id }} .hxPanel__table{border-top:1px solid rgba(0,0,0,.10)}
    #tabs-{{ section.id }} .hxPanel__row{display:grid;grid-template-columns:240px 1fr;gap:16px;padding:16px 0;border-bottom:1px solid rgba(0,0,0,.06);font-size:15px;line-height:1.5}
    #tabs-{{ section.id }} .hxPanel__row>div:first-child{color:rgba(0,0,0,.86)}
    #tabs-{{ section.id }} .hxPanel__row>div:last-child{color:rgba(0,0,0,.62)}
    #tabs-{{ section.id }} .hxGeo__images{display:flex;flex-direction:column;gap:24px}
    #tabs-{{ section.id }} .hxGeo__images img{display:block;width:100%;height:auto;border-radius:12px}

    #tabs-{{ section.id }} .hxAssembly{max-width:1200px;margin:auto;padding:40px clamp(16px,3vw,56px)}
    #tabs-{{ section.id }} .hxAssembly__ratio{position:relative;padding-top:56.25%;background:rgba(0,0,0,.04);border:1px solid rgba(0,0,0,.08);border-radius:12px;overflow:hidden}
    #tabs-{{ section.id }} .hxAssembly iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

    #tabs-{{ section.id }} .sf{max-width:var(--max);margin:auto;padding:40px clamp(16px,3vw,56px)}
    #tabs-{{ section.id }} .sf__grid{display:grid;grid-template-columns:140px 1fr 1fr;gap:clamp(18px,3vw,44px);align-items:center;padding:clamp(18px,4vw,38px) 0}
    #tabs-{{ section.id }} .sf__slider{position:relative;width:110px;height:300px;margin:auto;--fill:50%;--fit-top:15%;--fit-bottom:25%}
    #tabs-{{ section.id }} .sf__slider:before,#tabs-{{ section.id }} .sf__slider:after{content:"";position:absolute;left:50%;transform:translateX(-50%);width:6px;border-radius:999px;pointer-events:none}
    #tabs-{{ section.id }} .sf__slider:before{inset:0 auto 0 50%;background:color-mix(in srgb,var(--accent) 26%,transparent)}
    #tabs-{{ section.id }} .sf__slider:after{top:var(--fill);bottom:0;background:var(--accent)}
    #tabs-{{ section.id }} .sf__fitBand{position:absolute;left:50%;top:var(--fit-top);bottom:var(--fit-bottom);transform:translateX(-50%);width:14px;border-radius:999px;background:rgba(34,197,94,.14)}
    #tabs-{{ section.id }} .sf__knob{position:absolute;left:50%;top:50%;z-index:2;width:66px;height:66px;border-radius:50%;display:grid;place-items:center;transform:translate(-50%,-50%);background:var(--accent);color:#fff;font-size:15px;font-weight:500;pointer-events:none}
    #tabs-{{ section.id }} .sf__hit{position:absolute;inset:-10px;z-index:3;appearance:none;border:0;background:transparent;cursor:grab;touch-action:none}
    #tabs-{{ section.id }} .sf__height{display:flex;align-items:baseline;gap:10px;color:#111}
    #tabs-{{ section.id }} .sf__height span{width:3.2em;font-size:40px;font-weight:500;font-variant-numeric:tabular-nums}
    #tabs-{{ section.id }} .sf__height b{font-size:30px;font-weight:500}
    #tabs-{{ section.id }} .sf__sub{margin:8px 0 0;font-size:14px;color:rgba(0,0,0,.62)}
    #tabs-{{ section.id }} .sf__rule{width:min(560px,100%);height:1px;margin:22px 0;background:rgba(0,0,0,.12)}
    #tabs-{{ section.id }} .sf__result{display:flex;gap:12px;max-width:560px}
    #tabs-{{ section.id }} .sf__icon{width:18px;height:18px;margin-top:6px;border-radius:50%;background:#16a34a;flex:0 0 auto;position:relative}
    #tabs-{{ section.id }} .sf__icon:after{content:"";position:absolute;left:5px;top:4px;width:7px;height:4px;border-left:2px solid #fff;border-bottom:2px solid #fff;transform:rotate(-45deg)}
    #tabs-{{ section.id }} .sf.is-bad .sf__icon{background:#ef4444}
    #tabs-{{ section.id }} .sf.is-bad .sf__icon:after{left:4px;top:4px;width:10px;height:10px;border:0;background:linear-gradient(45deg,transparent 46%,#fff 46%,#fff 54%,transparent 54%),linear-gradient(-45deg,transparent 46%,#fff 46%,#fff 54%,transparent 54%)}
    #tabs-{{ section.id }} .sf__desc{margin:0;min-height:3.2em;font-size:14px;line-height:1.55;color:rgba(22,163,74,.95)}
    #tabs-{{ section.id }} .sf.is-bad .sf__desc{color:rgba(239,68,68,.95)}
    #tabs-{{ section.id }} .sf__hint{margin:10px 0 0;font-size:13px;color:rgba(0,0,0,.55)}
    #tabs-{{ section.id }} .sf__image{position:relative;height:max(clamp(360px,30vw,560px),var(--imgbox,0px));overflow:hidden;--bottom:6%}
    #tabs-{{ section.id }} .sf__sil{position:absolute;left:50%;bottom:var(--bottom);height:var(--sil-h,86%);max-width:78%;width:auto;transform:translateX(-50%);opacity:.22;filter:grayscale(1);pointer-events:none}
    #tabs-{{ section.id }} .sf__bike{position:absolute;left:50%;bottom:var(--bottom);width:min(760px,110%);height:auto;transform:translateX(-50%)}

    @media (max-width:990px){
      #tabs-{{ section.id }}{padding-top:var(--tabs-padding-top)}
      #tabs-{{ section.id }} .hxTabs__header{padding:0 clamp(16px,3vw,24px)}
      #tabs-{{ section.id }} .hxTabs__title{text-align:left;font-size:22px;margin-bottom:10px}
      #tabs-{{ section.id }} .hxTabs__nav{justify-content:flex-start;gap:10px}
      #tabs-{{ section.id }} .hxTabs__tab{font-size:13px;padding:10px 12px}
      #tabs-{{ section.id }} .hxPanel{padding:40px 0}
      #tabs-{{ section.id }} .hxPanel__grid{grid-template-columns:1fr;gap:0;padding:0 clamp(16px,3vw,24px)}
      #tabs-{{ section.id }} .hxPanel__grid--geo{padding:0}
      #tabs-{{ section.id }} .hxGeo .hxPanel__table{padding:0 clamp(16px,3vw,24px)}
      #tabs-{{ section.id }} .hxGeo__images{order:-1;gap:16px}
      #tabs-{{ section.id }} .hxGeo__images img{border-radius:0}
      #tabs-{{ section.id }} .hxPanel__row{grid-template-columns:1fr 1fr;gap:12px;padding:14px 0;font-size:14px}
      #tabs-{{ section.id }} .hxPanel__row>div:last-child{text-align:right}
      #tabs-{{ section.id }} .hxPanel__row--stack{grid-template-columns:1fr}
      #tabs-{{ section.id }} .hxPanel__row--stack>div:last-child{text-align:left}
      #tabs-{{ section.id }} .hxAssembly{max-width:100%;padding:40px 0}
      #tabs-{{ section.id }} .hxAssembly__ratio{border-left:0;border-right:0;border-radius:0}
      #tabs-{{ section.id }} .sf{padding:40px clamp(16px,3vw,24px)}
      #tabs-{{ section.id }} .sf__grid{grid-template-columns:92px 1fr;grid-template-areas:"slider copy" "image image";gap:14px;padding:18px 0 6px}
      #tabs-{{ section.id }} .sf__slider{grid-area:slider;width:86px;height:150px}
      #tabs-{{ section.id }} .sf__copy{grid-area:copy}
      #tabs-{{ section.id }} .sf__image{grid-area:image;margin-top:10px}
      #tabs-{{ section.id }} .sf__knob{width:44px;height:44px;font-size:13px}
      #tabs-{{ section.id }} .sf__height span{font-size:22px;width:3.4em}
      #tabs-{{ section.id }} .sf__height b{font-size:18px}
      #tabs-{{ section.id }} .sf__sub,#tabs-{{ section.id }} .sf__desc{font-size:13px}
      #tabs-{{ section.id }} .sf__hint{font-size:12px}
      #tabs-{{ section.id }} .sf__sil{max-width:58%;opacity:.18}
      #tabs-{{ section.id }} .sf__bike{width:min(640px,110%)}
    }
  </style>

  <script>
    (() => {
      const root = document.getElementById('tabs-{{ section.id }}');
      if (!root) return;

      const tabs = [...root.querySelectorAll('[data-tab]')];
      const panels = [...root.querySelectorAll('[data-panel]')];
      const activate = (name) => {
        tabs.forEach((tab) => {
          const on = tab.dataset.tab === name;
          tab.classList.toggle('is-active', on);
          tab.setAttribute('aria-selected', on);
          tab.tabIndex = on ? 0 : -1;
        });
        panels.forEach((panel) => {
          const on = panel.dataset.panel === name;
          panel.classList.toggle('is-active', on);
          panel.hidden = !on;
        });
        if (name === 'fit') requestAnimationFrame(() => window.dispatchEvent(new Event('resize')));
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => activate(tab.dataset.tab));
        tab.addEventListener('keydown', (e) => {
          const lastTab = tabs[tabs.length - 1];
          const map = { ArrowRight: tabs[i + 1] || tabs[0], ArrowLeft: tabs[i - 1] || lastTab, Home: tabs[0], End: lastTab };
          if (!map[e.key]) return;
          e.preventDefault();
          map[e.key].focus();
          activate(map[e.key].dataset.tab);
        });
      });

      const sf = root.querySelector('[data-sf]');
      if (!sf) return;
      const slider = sf.querySelector('[data-sf-slider]');
      const hit = sf.querySelector('[data-sf-hit]');
      const knob = sf.querySelector('[data-sf-knob]');
      const knobText = sf.querySelector('[data-sf-knob-text]');
      const display = sf.querySelector('[data-sf-display]');
      const desc = sf.querySelector('[data-sf-desc]');
      const sil = sf.querySelector('.sf__sil');
      const bike = sf.querySelector('.sf__bike');
      const min = 60, max = 80, okMin = 65, okMax = 77;
      const okText = {{ section.settings.ok_text | json }};
      const badText = {{ section.settings.bad_text | json }};
      let dragging = false, value = 72;

      const clamp = (n, a, b) => Math.max(a, Math.min(b, n));
      const fmt = (n) => `${Math.floor(n / 12)}'${n % 12}"`;
      const knobHalf = () => Math.max(10, (knob.getBoundingClientRect().height || 0) / 2);
      const valueFromY = (y) => {
        const r = slider.getBoundingClientRect();
        const h = knobHalf();
        const pos = clamp(y - r.top, h, r.height - h);
        return Math.round(min + (1 - (pos - h) / Math.max(1, r.height - h * 2)) * (max - min));
      };
      const draw = (n = value) => {
        value = clamp(n, min, max);
        const p = (value - min) / (max - min);
        const h = knobHalf();
        const r = slider.getBoundingClientRect();
        const travel = Math.max(1, r.height - h * 2);
        const top = h + (1 - p) * travel;
        const pct = (top / Math.max(1, r.height)) * 100;
        const ok = value >= okMin && value <= okMax;

        knob.style.top = `${pct}%`;
        slider.style.setProperty('--fill', `${pct}%`);
        slider.style.setProperty('--fit-top', `${(h + (1 - ((okMax - min) / (max - min))) * travel) / r.height * 100}%`);
        slider.style.setProperty('--fit-bottom', `${100 - ((h + (1 - ((okMin - min) / (max - min))) * travel) / r.height * 100)}%`);
        knobText.textContent = display.textContent = fmt(value);
        sf.classList.toggle('is-bad', !ok);
        desc.textContent = ok ? okText : badText;

        if (sil && bike) {
          const bikeH = bike.getBoundingClientRect().height || 0;
          if (bikeH) {
            sf.style.setProperty('--sil-h', `${Math.round(bikeH * (1.3 + p * 0.3))}px`);
            sf.style.setProperty('--imgbox', `${Math.round(bikeH * 1.72)}px`);
          }
        }
      };

      hit.addEventListener('pointerdown', (e) => {
        dragging = true;
        hit.setPointerCapture?.(e.pointerId);
        draw(valueFromY(e.clientY));
      });
      hit.addEventListener('pointermove', (e) => dragging && draw(valueFromY(e.clientY)));
      hit.addEventListener('pointerup', (e) => {
        dragging = false;
        try { hit.releasePointerCapture?.(e.pointerId); } catch (_) {}
      });
      hit.addEventListener('pointercancel', () => dragging = false);
      [sil, bike].forEach((img) => img?.addEventListener('load', () => draw()));
      window.addEventListener('resize', () => draw());
      draw();
      activate('fit');
    })();
  </script>
</section>

{% schema %}
{
  "name": "Spec Tabs Inline",
  "settings": [
    { "type": "text", "id": "title", "label": "Main title", "default": "Specification & Geometry" },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#ff4a12" },
    { "type": "range", "id": "max_width", "label": "Size & Fit max width", "min": 960, "max": 1600, "step": 20, "default": 1280 },
    { "type": "text", "id": "ok_text", "label": "Size & Fit OK text", "default": "You will be able to pedal and stand over the frame comfortably." },
    { "type": "text", "id": "bad_text", "label": "Size & Fit Bad text", "default": "You may experience discomfort on extended riding periods." },
    { "type": "image_picker", "id": "silhouette", "label": "Size & Fit silhouette image" },
    { "type": "image_picker", "id": "bike_image", "label": "Size & Fit bike image" },
